+ tar -xzf pcl-1.9.1.tar.gz
+ cd pcl-pcl-1.9.1
+ find . -type f -name '*.h' -o -name '*.hpp' -o -name '*.cpp'
+ xargs sed -i 's|boost/detail/endian.hpp|boost/endian.hpp|g'
+ cat
+ sed -i '1i#include "endian_compat.h"' io/include/pcl/io/ply/byte_order.h
+ mkdir build
+ cd build
+ export 'CXXFLAGS=-DBOOST_ENDIAN_LITTLE_ENDIAN=1234 -DBOOST_ENDIAN_BIG_ENDIAN=4321 -DBOOST_ENDIAN_NATIVE_ENDIAN=1234'
+ CXXFLAGS='-DBOOST_ENDIAN_LITTLE_ENDIAN=1234 -DBOOST_ENDIAN_BIG_ENDIAN=4321 -DBOOST_ENDIAN_NATIVE_ENDIAN=1234'
+ cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_surface_on_nurbs=ON -DUSE_UMFPACK=ON -DBUILD_examples=OFF -DBUILD_apps=OFF -DWITH_VTK=OFF -DWITH_QT=OFF -DBUILD_visualization=OFF -DWITH_OPENGL=OFF -DPython3_EXECUTABLE=/usr/bin/python3 '-DCMAKE_CXX_FLAGS=-DBOOST_ENDIAN_LITTLE_ENDIAN=1234 -DBOOST_ENDIAN_BIG_ENDIAN=4321 -DBOOST_ENDIAN_NATIVE_ENDIAN=1234' ..
