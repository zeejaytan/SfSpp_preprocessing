+def _rank_by_profile(reps, sizes, C0, C1, C, max_candidates, verbose=False):
+    """Ticket 322: order the pool's basins by profile thickness (sfs_axes/profile.py).
+
+    One test for every shape and size of vessel: about its axis each wall collapses to
+    one curve in the (r, z) plane. No shape branch, no base exception, no millimetre
+    window -- the cost is compared only between lines of this piece. Each of the
+    PROFILE_BASINS most-drawn basins enters twice (its representative and that
+    representative after the normal-cost refinement); the PROFILE_REFINE_K cheapest
+    distinct lines are refined on the profile cost itself and re-ordered.
+    """
+    n = C.shape[1]
+    centre = C[0:3].mean(axis=1)
+    size = float(np.linalg.norm(C[0:3].max(axis=1) - C[0:3].min(axis=1)))
+    walls = [stride(C0), stride(C1)]
+    Cr = C[:, 0:n:max(1, int(np.ceil(n / PROFILE_NREF)))]
+    pool = []
+    for j in np.argsort(-sizes, kind="stable")[:PROFILE_BASINS]:
+        raw = reps[:, j]
+        ref = refine_axis_normalized(raw, Cr, max_iters=PROFILE_NORMAL_ITERS, tolerance=1e-6)
+        pool.append((profile_cost(raw, walls), raw))
+        pool.append((profile_cost(ref, walls), ref))
+    pool.sort(key=lambda x: x[0])
+    top = _distinct_lines([v for _, v in pool])[:PROFILE_REFINE_K]
+    fin = []
+    for v in top:
+        v_ref, c_ref = refine_axis_profile(v, walls, centre, size)
+        fin.append((c_ref, v_ref))
+    fin.sort(key=lambda x: x[0])
+    kept = _distinct_lines([v for _, v in fin])
+    if verbose:
+        print("[POTSAC-UNION-PROFILE] %d basins scored, %d refined, kept %d, costs %s"
+              % (len(pool) // 2, len(top), len(kept),
+                 [round(c, 4) for c, _ in fin][:max_candidates]))
+    return np.column_stack(kept[:max_candidates])
+
