+def _distinct_lines(lines, tol_deg=PROFILE_DEDUP_DEG):
+    """Keep each line unless it is within tol_deg of one already kept (first wins)."""
+    kept = []
+    for v in lines:
+        if all(direction_angle_deg(v[0:3], k[0:3]) >= tol_deg for k in kept):
+            kept.append(v)
+    return kept
+
