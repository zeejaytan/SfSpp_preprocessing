+def test_profile_ranking_is_scale_free():
+    """Ticket 322: the same globular sherd at 1/5, 1 and 5 times its size gets the same axis."""
+    from sfs_axes.potsac import run_potsac_union
+
+    def make_belly(rng, scale, n=700, arc=np.radians(80.0)):
+        # bulbous wall: r(z) = 16 - 0.02 z^2 (mm at scale 1), z in [-14, 14]
+        walls = []
+        for off in (0.0, 1.8):
+            th = rng.uniform(-arc / 2, arc / 2, n)
+            z = rng.uniform(-14.0, 14.0, n)
+            r = 16.0 - off - 0.02 * z ** 2
+            drdz = -0.04 * z
+            P = np.stack([r * np.cos(th), r * np.sin(th), z]) * scale
+            N = np.stack([np.cos(th), np.sin(th), -drdz])
+            N /= np.linalg.norm(N, axis=0, keepdims=True)
+            walls.append(np.vstack([P, N]))
+        return walls
+
+    dirs = []
+    for scale in (0.2, 1.0, 5.0):
+        C0, S1 = make_belly(np.random.default_rng(7), scale)
+        vt = run_potsac_union(C0, S1, seeds=range(3), normalized=True)
+        assert direction_angle_deg(vt[:3, 0], [0, 0, 1]) < 5.0
+        dirs.append(vt[:3, 0])
+    assert direction_angle_deg(dirs[0], dirs[2]) < 1.0
+
