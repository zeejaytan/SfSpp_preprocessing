+
+// Estimate average point spacing using k-nearest neighbors
+template<typename PointT>
+double estimatePointSpacing(typename pcl::PointCloud<PointT>::Ptr cloud, int k = 5) {
+    if (cloud->points.size() < k + 1) {
+        return 1.0;  // Default to 1mm if too few points
+    }
+
+    pcl::KdTreeFLANN<PointT> kdtree;
+    kdtree.setInputCloud(cloud);
+
+    double totalSpacing = 0.0;
+    int sampleCount = std::min(500, (int)cloud->points.size());  // Sample up to 500 points
+    int step = std::max(1, (int)cloud->points.size() / sampleCount);
+    int validSamples = 0;
+
+    for (size_t i = 0; i < cloud->points.size() && validSamples < sampleCount; i += step) {
+        std::vector<int> indices(k + 1);
+        std::vector<float> distances(k + 1);
+
+        if (kdtree.nearestKSearch(cloud->points[i], k + 1, indices, distances) > 0) {
+            // Average distance to k nearest neighbors (skip self at index 0)
+            double avgDist = 0.0;
+            for (int j = 1; j <= k; j++) {
+                avgDist += std::sqrt(distances[j]);
+            }
+            avgDist /= k;
+            totalSpacing += avgDist;
+            validSamples++;
+        }
+    }
+
+    double spacing = (validSamples > 0) ? totalSpacing / validSamples : 1.0;
+    return std::max(0.1, std::min(10.0, spacing));  // Clamp to reasonable range (0.1mm - 10mm)
+}
+
+// Compute adaptive CGAL neighbors based on point spacing
+// Reference: 5 neighbors for 1.0mm spacing
+int adaptiveCGALNeighbors(double spacing) {
+    const double refSpacing = 1.0;  // mm
+    const int refNeighbors = 5;
+
+    // Scale inversely with spacing: denser mesh needs more neighbors
+    // But clamp to reasonable range [5, 12]
+    int neighbors = (int)(refNeighbors * (refSpacing / spacing));
+    return std::max(5, std::min(12, neighbors));
+}
+
+// Compute adaptive region growing K based on point spacing
+// Reference: K=10 for 1.0mm spacing
+int adaptiveRegionGrowingK(double spacing) {
+    const double refSpacing = 1.0;  // mm
+    const int refK = 10;
+
+    // Scale inversely with spacing: denser mesh needs more neighbors for same physical region
+    // Clamp to [8, 15] to avoid extreme values
+    int K = (int)(refK * (refSpacing / spacing));
+    return std::max(8, std::min(15, K));
+}
+
+// Compute adaptive minCluster based on point spacing
+// Reference: minCluster=50 for 1.0mm spacing (~50mm² minimum feature)
+int adaptiveMinCluster(double spacing, int defaultMin = 50) {
+    const double refSpacing = 1.0;  // mm
+    const int refMinCluster = 50;
+
+    // Scale with inverse square of spacing: denser mesh has more points per area
+    // minCluster represents minimum feature SIZE, which scales with point density
+    double scale = (refSpacing / spacing) * (refSpacing / spacing);
+    int minCluster = (int)(refMinCluster * scale);
+    return std::max(defaultMin, std::min(500, minCluster));  // Clamp to [defaultMin, 500]
+}
