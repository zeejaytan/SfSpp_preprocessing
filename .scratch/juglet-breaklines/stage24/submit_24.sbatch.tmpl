#!/usr/bin/env bash
#SBATCH --account=punim2657
#SBATCH --partition=sapphire
#SBATCH --job-name=__JOBNAME__
#SBATCH --time=__TIME__
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --output=logs/slurm-%j.out
#
# ticket 24, normals grid. One run directory per job; one cell per (arm, piece) under out/cells/.
# Phase "grid": builds the new commit and the pre-change commit from the canonical checkout's
# object store, runs A, A2, A_old, B, C, D over the nine Juglet pieces and Pot A 01-08, measures
# every normals call against the MESH normal at the nearest surface point, measures the surface
# pairs and their coverage, proves the defaults and the inputs unchanged, and selects arm E's
# radius setting by the rule fixed in pick_arm_e24.py.
# Phase "e": arm E (the selected radius setting carrying ticket 23's full switch set) over the
# same 17 pieces, then the renders.
# Nothing is scored here and no arm is called better: cells24.tsv, status23.tsv, angles24_all.tsv,
# measure23.tsv, coverage23.tsv, arm_e.txt and the renders are the record.
set -uo pipefail
RUN=__RUNDIR__
NEW=__NEWCOMMIT__
OLD=__OLDCOMMIT__
PIECES="__PIECES__"
TAGS="__TAGS__"
PHASE=__PHASE__
GRIDRUN="__GRIDRUN__"
EENV="__EENV__"
# arms_env is exported to the xargs child shells, so every variable it reads must be exported too:
# a plain shell variable is invisible in "bash -c", which is exactly how arm E silently ran with no
# environment at all in job 33841866 (cells24 envs=none, nmode=count).
export EENV
IXTAG=__IXTAG__
CANON=/data/gpfs/projects/punim2657/sfs_preprocessing
CORP=/data/gpfs/projects/punim2657/sfs_main/original_samples/SfS_pp
BOOT=/data/gpfs/projects/punim2657/SfSpp/runs/20261027-0055_d8af9d2_p07-juglet-stage1/out/boot
SIF=$CANON/pcl_191_nurbs.sif
APT=/apps/easybuild-2022/easybuild/software/Compiler/GCCcore/11.3.0/Apptainer/1.3.3/bin/apptainer
PY=/data/gpfs/projects/punim2657/TORA/envs/tora/bin/python3
INSTR=$RUN/instruments
CELLROOT=$RUN/out/cells
RUNID=$(basename "$RUN")
export RUN NEW OLD CANON CORP BOOT SIF APT INSTR CELLROOT RUNID PY \
       SLURM_CPUS_PER_TASK SLURM_JOB_ID

cd "$RUN" || exit 1
mkdir -p logs out/cells build out/bin out/renders
say() { echo "[$(date +%H:%M:%S)] $*"; }

pot_of() {
  case "$1" in
    Juglet_Piece_*) echo "Juglet" ;;
    *) echo "Pot_A" ;;
  esac
}

axis_of() {
  case "$1" in
    Juglet_Piece_*) echo "$BOOT/$1_boot_Axis.xyz" ;;
    *) echo "$CANON/Dataset/Axes/Pot_A/$1_Axis.xyz" ;;
  esac
}

hash_inputs() {
  local pot p f
  for p in $PIECES; do
    pot=$(pot_of "$p")
    if [ "$pot" = "Pot_A" ]; then
      f="$CORP/Point/Pot_A/${p}_Point.pcd"; [ -f "$f" ] && md5sum "$f"
      f="$CORP/Mesh/${p}_Mesh.obj"; [ -f "$f" ] && md5sum "$f"
    else
      f="$CANON/Dataset/Point/$pot/${p}_Point.pcd"; [ -f "$f" ] && md5sum "$f"
      f="$CANON/Dataset/Mesh/$pot/${p}_Mesh.obj"; [ -f "$f" ] && md5sum "$f"
    fi
    f=$(axis_of "$p"); [ -f "$f" ] && md5sum "$f"
  done | sort -k2
}

corpus_tree() {
  find "$CORP" -type f -printf '%p\t%s\t%T@\n' 2>/dev/null | sort
  ls -R /opt/sfs-pristine 2>/dev/null | md5sum || echo "opt-sfs-pristine NA"
}

build_arm() {
  local name=$1 sha=$2 rc
  say "build $name from $sha"
  mkdir -p "build/$name/src/build"
  git -C "$CANON" archive "$sha" | tar -x -C "build/$name/src" || { say "archive FAILED $sha"; return 1; }
  ( cd "build/$name/src/build" \
    && "$APT" exec --bind /data:/data "$SIF" cmake -DCMAKE_BUILD_TYPE=Release .. \
    && "$APT" exec --bind /data:/data "$SIF" make -j"${SLURM_CPUS_PER_TASK:-8}" MeshPreprocessingHeadless \
  ) > "logs/build-$name.log" 2>&1
  rc=$?
  if [ $rc -eq 0 ] && [ -x "build/$name/src/build/MeshPreprocessingHeadless" ]; then
    cp -f "build/$name/src/build/MeshPreprocessingHeadless" "out/bin/MeshPreprocessingHeadless.$name"
    say "build $name ok"
    return 0
  fi
  say "build $name FAILED rc=$rc -- tail of logs/build-$name.log:"
  tail -20 "logs/build-$name.log"
  return 1
}

arms_env() {
  case "$1" in
    A|A2|A_old) echo "" ;;
    B) echo "SFS_NORMAL_MODE=radius SFS_NORMAL_RADIUS_MM=auto SFS_NORMAL_RADIUS_MULT=2" ;;
    C) echo "SFS_NORMAL_MODE=radius SFS_NORMAL_RADIUS_MM=auto SFS_NORMAL_RADIUS_MULT=3" ;;
    D) echo "SFS_NORMAL_MODE=radius SFS_NORMAL_RADIUS_MM=1.0" ;;
    E) [ -n "$EENV" ] || echo "ARM-E-ENV-MISSING" >&2; echo "$EENV" ;;
    *) echo "" ;;
  esac
}

arm_bin() {
  case "$1" in
    A_old) echo old ;;
    *) echo new ;;
  esac
}

run_one() {
  local tag=$1 piece=$2 bk
  bk=$(arm_bin "$tag")
  POT=$(pot_of "$piece")
  PIECE=$piece
  TAG=$tag
  ENVS=$(arms_env "$tag")
  AXIS=$(axis_of "$piece")
  BIN=$RUN/build/$bk/src/build/MeshPreprocessingHeadless
  STAGER=$INSTR/stage_piece_p24.sh
  ANGLER=$INSTR/mesh_angle24.py
  if [ "$bk" = "old" ]; then COMMIT=$OLD; else COMMIT=$NEW; fi
  export POT PIECE TAG ENVS AXIS BIN STAGER ANGLER COMMIT PY
  bash "$INSTR/run_cell24.sh" "$tag"
}

say "job ${SLURM_JOB_ID:-local} run=$RUNID phase=$PHASE pieces=$PIECES arms=$TAGS"
hash_inputs > out/inputs_before.md5
corpus_tree > out/corpus_before.txt
say "inputs hashed: $(wc -l < out/inputs_before.md5) files; corpus listing $(wc -l < out/corpus_before.txt) lines"

build_arm new "$NEW" || exit 2
[ "$PHASE" = "grid" ] && { build_arm old "$OLD" || exit 2; }

say "self-testing the mesh-normal instrument before spending cell time"
"$PY" "$INSTR/mesh_angle24.py" --selftest > out/angle_selftest.log 2>&1
SRC=$?
cat out/angle_selftest.log
if [ $SRC -ne 0 ]; then
  say "ABORT: mesh_angle24.py --selftest exit=$SRC -- see out/angle_selftest.log"
  exit 3
fi
say "angle selftest ok"

printf "tag\tpot\tpiece\tenvs\tmesh_exit\telapsed_s\tnpts\tretries\tclusters\tsizes\toutcome\tfloor\tfloor_from\tcapped\tsurf0\tsurf1\tsurf0_points\tsurf1_points\tswitch\tfloor_line\tsingle\tstatus\tspacing\tcount\twarn_missing\tsurf0_bytes\tcalls\tnmode\tcgalk\tradii\tnbr_med\tnbr_min\tnbr_max\torient_k\tfloored\tcapped24\tcloud_spacing\tswitch24\n" > out/cells/cells24.tsv
printf "tag\tpot\tpiece\tnpts\tretries\tclusters\tsizes\tfloor\tfloor_from\tcapped\toutcome\tsurf0_points\tsurf1_points\tsingle_cluster\tfloor_ceiling_on\treason\n" > out/cells/status23.tsv
printf "cell\text\tcount\tbytes\n" > out/cells/geometry_counts.tsv
: > out/cells.list
for p in $PIECES; do for t in $TAGS; do echo "$t $p" >> out/cells.list; done; done
EXPECT=$(wc -l < out/cells.list)
say "cells to run: $EXPECT"
for t in $TAGS; do say "arm $t env=[$(arms_env "$t")]"; done
if [ "$PHASE" = "e" ] && [ -z "$(arms_env E)" ]; then
  say "ABORT: arm E has no environment -- EENV is empty in this script"
  exit 3
fi

export -f pot_of axis_of arms_env arm_bin run_one
xargs -a out/cells.list -n 2 -P "${SLURM_CPUS_PER_TASK:-8}" bash -c 'run_one "$@"' _ 2>&1 | tee out/run_cells.log | grep -c '^\[CELL\]' | xargs -I{} echo "[$(date +%H:%M:%S)] cells reported: {}"
GOT=$(($(wc -l < out/cells/cells24.tsv) - 1))
if [ "$GOT" = "$EXPECT" ]; then
  say "[CHECK] cell rows $GOT == cells asked $EXPECT"
else
  say "[CHECK] CELL COUNT MISMATCH rows=$GOT asked=$EXPECT -- see out/run_cells.log"
fi

say "collecting the normals angle tables"
{ head -1 out/cells/A/Juglet/Juglet_Piece_1/angles24.tsv 2>/dev/null || printf "tag\tpot\tpiece\tcall\tn\tmed_signed_deg\tmed_abs_deg\tp90_abs_deg\tfrac_abs_gt10\tfrac_abs_gt30\tfrac_same_hemisphere\tmed_dist_mm\tframe_ok\n"; find out/cells -name angles24.tsv | sort | xargs -r -I{} tail -n +2 {}; } > out/angles24_all.tsv
say "angle rows: $(($(wc -l < out/angles24_all.tsv) - 1)) across $(find out/cells -name angles24.tsv | wc -l) cells"
# column 27 is "calls", the count of [NORMAL-24] lines, i.e. normals PLYs the stage dumped
NONCELL=$(awk -F'\t' 'NR>1 && $27==0' out/cells/cells24.tsv | wc -l)
say "[CHECK] cells whose stage dumped no normals PLY: $NONCELL"
NOENV=$(awk -F'\t' 'NR>1 && $4=="none"' out/cells/cells24.tsv | wc -l)
say "[CHECK] cells whose environment was empty: $NOENV (expected 0 in a switch arm, 17 per switchless arm)"
if [ "$PHASE" = "e" ] && [ "$NOENV" != "0" ]; then
  say "ABORT: arm E cells ran without their switches -- see the envs column of cells24.tsv"
  exit 3
fi

cp -f out/cells/cells24.tsv out/cells/cells23.tsv
say "measuring surface pairs"
"$PY" "$INSTR/measure_arm23.py" "$CELLROOT" > out/measure.log 2>&1
say "measure exit=$? -> $(tail -1 out/measure.log)"
say "measuring coverage of each written surface"
"$PY" "$INSTR/coverage23.py" "$CELLROOT" > out/coverage.log 2>&1
say "coverage exit=$? -> $(tail -1 out/coverage.log)"

if [ "$PHASE" = "grid" ]; then
  say "defaults proof against the pre-change binary"
  for pot in Juglet Pot_A; do
    ps=""
    for p in $PIECES; do [ "$(pot_of "$p")" = "$pot" ] && ps="$ps $p"; done
    [ -n "$ps" ] || continue
    SFS_PROOF_OUT="$RUN/out/defaults_proof_$pot.tsv" "$PY" "$INSTR/defaults_proof23.py" "$CELLROOT" "$pot" $ps > "out/defaults_proof_$pot.log" 2>&1
    say "defaults proof $pot exit=$? -> $(tail -1 "out/defaults_proof_$pot.log")"
  done
  printf "B\tSFS_NORMAL_MODE=radius SFS_NORMAL_RADIUS_MM=auto SFS_NORMAL_RADIUS_MULT=2\nC\tSFS_NORMAL_MODE=radius SFS_NORMAL_RADIUS_MM=auto SFS_NORMAL_RADIUS_MULT=3\nD\tSFS_NORMAL_MODE=radius SFS_NORMAL_RADIUS_MM=1.0\n" > out/arms_env.tsv
  "$PY" "$INSTR/pick_arm_e24.py" "$CELLROOT" out/arms_env.tsv out/arm_e.txt B C D > out/pick_arm_e.log 2>&1
  say "arm E selection exit=$?"
  cat out/pick_arm_e.log
  printf "%s" "$(cut -f2 out/arm_e.txt)" > out/arm_e_env.txt
fi

if [ "$PHASE" = "e" ]; then
  say "linking the grid run's arms into this cell root for the renders"
  for t in A A2 A_old B C D; do
    [ -d "$GRIDRUN/out/cells/$t" ] && ln -sfn "$GRIDRUN/out/cells/$t" "out/cells/$t"
  done
  RTAGS=__RTAGS__
  RP=$(find out/cells/E -name angle_points.tsv 2>/dev/null | wc -l)
  say "cells with a per-point angle table in arm E: $RP"
  "$PY" "$INSTR/render24.py" "$CELLROOT" out/renders_smoke A "Juglet/Juglet_Piece_1" > out/render_smoke.log 2>&1
  SMOKE=$(ls out/renders_smoke/*.png 2>/dev/null | wc -l)
  say "render smoke exit=$? -> $SMOKE figure(s)"
  if [ "$SMOKE" = "0" ]; then
    say "ABORT RENDER ONLY: the smoke panel drew nothing -- see out/render_smoke.log"
    tail -5 out/render_smoke.log
  else
    "$PY" "$INSTR/render24.py" "$CELLROOT" out/renders "$RTAGS" "__RPIECES__" > out/render.log 2>&1
    say "render exit=$? -> $(grep -c '\[RENDER\] wrote' out/render.log) figures"
    tail -3 out/render.log
  fi
fi

hash_inputs > out/inputs_after.md5
if diff -q out/inputs_before.md5 out/inputs_after.md5 > /dev/null; then
  say "[CHECK] inputs unchanged: $(wc -l < out/inputs_after.md5) files identical before/after"
else
  say "[CHECK] INPUTS CHANGED -- see out/inputs_before.md5 out/inputs_after.md5"
  diff out/inputs_before.md5 out/inputs_after.md5 | head -20
fi
corpus_tree > out/corpus_after.txt
if diff -q out/corpus_before.txt out/corpus_after.txt > /dev/null; then
  say "[CHECK] frozen corpus and /opt/sfs-pristine unchanged: $(wc -l < out/corpus_after.txt) lines identical"
else
  say "[CHECK] CORPUS TREE CHANGED -- see out/corpus_before.txt out/corpus_after.txt"
  diff out/corpus_before.txt out/corpus_after.txt | head -20
fi

say "outcome counts by arm:"
awk -F'\t' 'NR>1{c[$1"/"$11]++} END{for (k in c) printf "  %s %d\n", k, c[k]}' out/cells/cells24.tsv | sort
awk -F'\t' 'NR>1{c+=$3; b+=$4} END{printf "[GEOM] deleted %d files, %d bytes\n", c, b}' out/cells/geometry_counts.tsv
say "run dir bytes: $(du -sb "$RUN" | awk '{print $1}')"
rm -rf build
printf "%s\t%s\t%s\t%s\t\t\n" "$RUNID" "${SLURM_JOB_ID:-local}" "$NEW" "$IXTAG" >> /data/gpfs/projects/punim2657/SfSpp/runs/index.tsv
say "done: cells24 $(($(wc -l < out/cells/cells24.tsv) - 1)) rows, measure23 $(($(wc -l < out/cells/measure23.tsv) - 1)) rows, coverage23 $(($(wc -l < out/cells/coverage23.tsv) - 1)) rows"
