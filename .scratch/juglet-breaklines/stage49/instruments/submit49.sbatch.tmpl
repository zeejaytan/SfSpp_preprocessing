#!/bin/bash
#SBATCH --job-name=__JOBNAME__
#SBATCH --account=punim2657
#SBATCH --partition=sapphire
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=__TIME__
#SBATCH --output=__RUNDIR__/logs/slurm-%j.out
#SBATCH --error=__RUNDIR__/logs/slurm-%j.err
# ticket 49 -- the fold radius measured over a FIXED PHYSICAL PATCH, then k re-derived.
#
# Source change under test (mesh_processing_headless.cpp, medianFoldRadius45): the neighbour
# query is tree45.radiusSearch(p45, SFS_PATCH_R_MM, ...) instead of the k = 30 nearest, the skip
# is < 6 points (a 6-parameter quadric is not determined by fewer), and the [GROWTH-45] line now
# carries patch_r= and skipped=NNN/MMM.  Nothing else in the estimator moved.
#
# Ticket 48 measured WHY: k = 30 is not a fixed patch, so the fitted radius shrank on the corpus
# clouds to 0.58-0.93x of its calibration value and theta came out 1.1-1.7x too steep (0 of 17 in
# the 2% band).  This job holds the patch size fixed and measures what happens to the angle AND to
# the grown pair -- the pair is the thing under test; tickets 44/46 scored the angle, not the pair.
#
# Grid: 2 patch radii x 2 cloud sets x 17 pieces = 51 cells, every cell carrying
#   SFS_GROWTH_FORMULA=1 SFS_PATCH_R_MM=<its own radius>
#   corpus  Juglet 1-9 on the ticket-47 corpus clouds (md5-gated against MANIFEST_JUGLET_CC.tsv,
#           run_cell49.sh pass 1) + Pot A 01-08 released clouds (control: 8/8 two surfaces in 45/48)
#   attic   Juglet 1-9 on the archived 2026-09-25 vertex dumps (md5-gated against the attic
#           manifest, pass 1b) -- the ticket-45 CALIBRATION case, the regression guard: the change
#           must not silently move the case that already worked.  Pot A has no attic dump.
#   radii   1.0 mm (the patch the k=30 calibration actually used, 0.63-1.04 mm) and 1.5 mm
# thetas49.tsv rides along COMMITTED as the ticket-43 k-rule reference; every theta is reported
# against it at the ~2% band as a REPORT, never a gate.
#
# Paid-for traps this script is written around: CRLF in any script (gate in the submitter);
# brace-stripping when this template renders (unrendered-placeholder and expansion-count checks);
# unbound variables under set -u; no xargs -d; grep -a on binary PCD/PLY; PLY header length varies;
# a SKIP row must carry the same field count as its header.
set -uo pipefail

RUN=__RUNDIR__
RUNID=__RUNID__
NEW=__NEWCOMMIT__
PHASE=__PHASE__
IXTAG=__IXTAG__
PARTA=__PARTA__
CANON=/data/gpfs/projects/punim2657/sfs_preprocessing
CORP=/data/gpfs/projects/punim2657/sfs_main/original_samples/SfS_pp
DS=$CANON/Dataset
SIF=$CANON/pcl_191_nurbs.sif
APT=/apps/easybuild-2022/easybuild/software/Compiler/GCCcore/11.3.0/Apptainer/1.3.3/bin/apptainer
PY=/data/gpfs/projects/punim2657/TORA/envs/tora/bin/python3
ATTIC=/data/gpfs/projects/punim2657/SfSpp/attic/20261031-juglet-vertex-dumps
RINSTR=$RUN/instruments
OUT=$RUN/out
RUNS=/data/gpfs/projects/punim2657/SfSpp/runs
IDX=$RUNS/index.tsv
JOBID=$SLURM_JOB_ID; [ -n "$JOBID" ] || JOBID=na
P=$SLURM_CPUS_PER_TASK; [ -n "$P" ] || P=8
unset SFS_COUNT_SCALE SFS_SPACING_POLICY SFS_SPACING_SAMPLES SFS_NORMAL_SOURCE SFS_NORMAL_CARRY \
      SFS_SINGLE_CLUSTER SFS_FLOOR_CEILING SFS_DOWNSAMPLE_TARGET SFS_DUMP_STAGE SFS_DUMP_PIECES \
      SFS_PAPER_THETA SFS_PAPER_KAPPA SFS_PAPER_NB SFS_PAPER_CHAIN SFS_SMOOTHNESS_DEG \
      SFS_CURVATURE_THRESH SFS_REASSIGN_MODE SFS_WINDOW_REPORT SFS_MERGE_SCALE SFS_GROWTH_MODE \
      SFS_GROWTH_FORMULA SFS_PATCH_R_MM SFS_AXIS_FILE SFS_STATUS_FILE POT_NAME 2>/dev/null || true
export CANON CORP DS SIF APT PY ATTIC OUT RUN RUNID NEW PHASE IXTAG PARTA RUNS IDX JOBID P

cd "$RUN" || exit 1
mkdir -p "$OUT" logs

fail() {
  local rc=$1; shift
  {
    echo "runid=$RUNID"
    echo "jobid=$JOBID"
    echo "commit=$NEW"
    echo "tag=$IXTAG"
    echo "rc=$rc"
    echo "reason: $*"
    date -u +"at %Y-%m-%dT%H:%M:%SZ"
  } > "$OUT/RUN-FAILED.txt"
  echo "[JOB] FATAL rc=$rc $* (see out/RUN-FAILED.txt)"
  exit "$rc"
}

echo "[JOB] runid=$RUNID job=$JOBID tag=$IXTAG phase=$PHASE new=$NEW host=$(hostname)"

git -C "$CANON" fetch --no-tags origin "+refs/heads/*:refs/remotes/origin/*" >> logs/fetch.log 2>&1
git -C "$CANON" rev-parse --verify --quiet "$NEW" > /dev/null 2>>logs/fetch.log || fail 2 "commit $NEW not in $CANON"

# the instruments the job executes are the PUSHED COMMIT bytes, not the run directory copies
SRC=$RUN/build/src
rm -rf "$SRC"; mkdir -p "$SRC"
git -C "$CANON" archive "$NEW" .scratch/juglet-breaklines/stage49 | tar -x -C "$SRC" \
  || fail 3 "git archive $NEW failed"
INSTR=$SRC/.scratch/juglet-breaklines/stage49/instruments
[ -d "$INSTR" ] || fail 3 "no stage49 instruments in commit $NEW"
( cd "$INSTR" && md5sum *.py *.sh *.tsv 2>/dev/null ) | sort -k2 > "$OUT/instruments_commit.md5"
( cd "$RINSTR" && md5sum *.py *.sh *.tsv 2>/dev/null ) | sort -k2 > "$OUT/instruments_rundir.md5"
if ! diff -q "$OUT/instruments_commit.md5" "$OUT/instruments_rundir.md5" > /dev/null; then
  diff "$OUT/instruments_rundir.md5" "$OUT/instruments_commit.md5" || true
  fail 4 "instruments in the run directory differ from commit $NEW"
fi
echo "[JOB] instruments match commit $NEW ($(wc -l < "$OUT/instruments_commit.md5") files)"
STAGER=$INSTR/stage_synth_p40.sh
export INSTR STAGER

corpus_tree() {
  local out=$1
  {
    find "$CORP" -type f -printf "%p\t%s\t%T@\n" | sort
    find "$DS" -type f -printf "%p\t%s\t%T@\n" | sort
    if [ -d "$ATTIC" ]; then
      find "$ATTIC" -type f -printf "%p\t%s\t%T@\n" | sort
    else
      echo "attic ABSENT $ATTIC"
    fi
    if [ -d /opt/sfs-pristine ]; then
      echo "opt-sfs-pristine PRESENT $(ls -R /opt/sfs-pristine | md5sum | cut -d' ' -f1)"
    else
      echo "opt-sfs-pristine ABSENT"
    fi
  } > "$out"
}
pristine_record() {
  local out=$1
  {
    echo "# /opt/sfs-pristine, recorded from the compute node"
    if [ -d /opt/sfs-pristine ]; then
      echo "status PRESENT"; ls -la /opt/sfs-pristine
    else
      echo "status ABSENT"
      ls -d /opt/sfs-pristine 2>&1 || true
      stat /opt/sfs-pristine 2>&1 || true
    fi
  } > "$out"
}
md5_corpus() {
  local out=$1 f
  {
    for f in "$DS"/Point/Juglet/*.pcd "$DS"/Point/Juglet/MANIFEST_JUGLET_CC.tsv \
             "$DS"/Mesh/Juglet/*.obj "$DS"/Axes/Juglet/*.xyz \
             "$DS"/Point/Pot_A/*.pcd "$DS"/Axes/Pot_A/*.xyz \
             "$CORP"/Point/Pot_A/*.pcd "$CORP"/Mesh/Pot_A_Piece_*.obj "$CORP"/Axes/*.xyz \
             "$ATTIC"/*.pcd "$ATTIC"/manifest.tsv; do
      [ -f "$f" ] && printf "%s\t%s\n" "$(md5sum "$f" | cut -d' ' -f1)" "$f"
    done
  } | sort -k2 > "$out"
}

corpus_tree "$OUT/corpus_before.tsv"
pristine_record "$OUT/pristine.txt"
md5_corpus "$OUT/inputs_before.md5"
{
  echo "host $(hostname)"
  echo "utc $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "commit $NEW"
  "$PY" -c "import numpy, scipy, sys; print('python', sys.version.split()[0]); print('numpy', numpy.__version__); print('scipy', scipy.__version__)" 2>&1
  "$PY" -c "import matplotlib; print('matplotlib', matplotlib.__version__)" 2>&1 || echo "matplotlib absent"
  "$APT" --version 2>&1 | head -2
  nproc
} > "$OUT/versions.txt" 2>&1
cat "$OUT/versions.txt"

build_bin() {
  local name=$1 sha=$2 rc
  echo "[BUILD] $name from $sha"
  mkdir -p "build/$name/src/build"
  git -C "$CANON" archive "$sha" | tar -x -C "build/$name/src" || { echo "[BUILD] archive FAILED"; return 1; }
  ( cd "build/$name/src/build" \
    && "$APT" exec --bind /data:/data "$SIF" cmake -DCMAKE_BUILD_TYPE=Release .. \
    && "$APT" exec --bind /data:/data "$SIF" make -j"$P" MeshPreprocessingHeadless \
  ) > "logs/build-$name.log" 2>&1
  rc=$?
  if [ "$rc" -eq 0 ] && [ -x "build/$name/src/build/MeshPreprocessingHeadless" ]; then
    cp -f "build/$name/src/build/MeshPreprocessingHeadless" "$OUT/bin-$name"
    echo "[BUILD] $name ok $(stat -c %s "$OUT/bin-$name") bytes md5=$(md5sum "$OUT/bin-$name" | cut -d' ' -f1)"
    return 0
  fi
  return 1
}

geom_record() {
  local out=$1
  {
    find "$OUT" -type f -printf "%p\t%s\n" 2>/dev/null | awk -F"\t" '
      { n=split($1,a,"."); ext=(n>1?a[n]:"none");
        if (ext !~ /^(pcd|ply|obj|xyz|stl|off)$/) next;
        f[ext]++; b[ext]+=$2; tf++; tb+=$2 }
      END { for (e in f) printf "%s\t%d\t%d\n", e, f[e], b[e];
            printf "TOTAL\t%d\t%d\n", tf, tb }'
  } | sort > "$out"
  cat "$out"
}
geom_delete() {
  # the cells surfaces are KEPT for the lead (the pair table and the panels are measured from them);
  # everything else under out/ is deleted, and the delete records itself first.
  local before after kept
  before=$(find "$OUT" -type f \( -name "*.pcd" -o -name "*.ply" -o -name "*.obj" -o -name "*.xyz" \) | wc -l)
  kept=$(find "$OUT" -path "*/cells-pipeline/*/surfaces/*.ply" -type f | wc -l)
  find "$OUT" -type f \( -name "*.pcd" -o -name "*.ply" -o -name "*.obj" -o -name "*.xyz" \) \
    -not -path "*/cells-pipeline/*/surfaces/*" -print0 | xargs -0 -r rm -f
  rm -rf "$OUT"/cells-pipeline/stage_* 2>/dev/null || true
  after=$(find "$OUT" -type f \( -name "*.pcd" -o -name "*.ply" -o -name "*.obj" -o -name "*.xyz" \) | wc -l)
  {
    echo "# geometry deleted by $RUNID phase $PHASE, $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "geometry_files_before $before"
    echo "geometry_files_after $after"
    echo "kept_cell_surface_plies $kept"
    echo "# kept: the cells surfaces (*/cells-pipeline/*/surfaces/*.ply), tsv json log py sh txt png"
  } > "$OUT/GEOMETRY_DELETED.txt"
  cat "$OUT/GEOMETRY_DELETED.txt"
}

JUG="Juglet_Piece_1 Juglet_Piece_2 Juglet_Piece_3 Juglet_Piece_4 Juglet_Piece_5 Juglet_Piece_6 Juglet_Piece_7 Juglet_Piece_8 Juglet_Piece_9"
POTA="Pot_A_Piece_01 Pot_A_Piece_02 Pot_A_Piece_03 Pot_A_Piece_04 Pot_A_Piece_05 Pot_A_Piece_06 Pot_A_Piece_07 Pot_A_Piece_08"

phase_cells() {  # every piece once: run_cell49.sh loops the radii and the cloud sets itself
  local list="" pot pcs p
  for pot in Juglet Pot_A; do
    if [ "$pot" = "Juglet" ]; then pcs=$JUG; else pcs=$POTA; fi
    for p in $pcs; do
      list="$list $pot:$p"
    done
  done
  echo "$list"
}

RC_ANY=0
rc=1
echo "[JOB] ---- phase $PHASE ----"
case "$PHASE" in
  4) ;;
  *) fail 6 "unknown phase $PHASE (ticket 49: 4 = the radius grid on 17 pieces)" ;;
esac

# ------------------------------------------------ the cells: 2 radii x 2 cloud sets x 17 pieces
cp -f "$INSTR/thetas49.tsv" "$OUT/thetas_committed.tsv"
echo "[JOB] reference thetas committed with ticket 43/48 (md5 $(md5sum "$OUT/thetas_committed.tsv" | cut -d' ' -f1))"
cat "$OUT/thetas_committed.tsv"

build_bin new "$NEW" || fail 5 "binary build failed (see logs/build-new.log)"
BIN=$OUT/bin-new; export BIN
export CELL_LIST="$(phase_cells)" RADII="1.0 1.5" CLOUDSETS="corpus attic" MIN_LEFT_S=180 CELL_BUDGET_S=3900
echo "[JOB] cells: 2 radii x 2 cloud sets x $(echo "$CELL_LIST" | wc -w) pieces"
echo "[JOB] pieces: $CELL_LIST"
bash "$INSTR/run_cell49.sh" > "$OUT/phase4_cells.log" 2>&1; rc=$?
[ -s "$OUT/phase4_cells.log" ] && tail -100 "$OUT/phase4_cells.log"
if [ "$rc" -ne 0 ]; then
  echo "[JOB] WARN the cells driver failed rc=$rc (see the cells log); closing record still written"
  printf "%s\t%s\n" "4" "$rc" >> "$OUT/phase_failures.tsv"
  RC_ANY=$rc
fi

# ---- theta check (REPORT ONLY): every [GROWTH-45] theta against the ticket-43 k-rule reference
"$PY" "$INSTR/theta_check49.py" --cells "$OUT/cells-pipeline/pipeline_cells.tsv" \
  --ref "$OUT/thetas_committed.tsv" --out "$OUT/theta_check49.tsv" > "$OUT/phase7_theta49.log" 2>&1
tcrc=$?
[ -s "$OUT/phase7_theta49.log" ] && tail -30 "$OUT/phase7_theta49.log"
if [ "$tcrc" -ne 0 ]; then
  echo "[JOB] WARN theta_check49 rc=$tcrc (no theta table produced -- see phase7_theta49.log)"
  printf "%s\t%s\n" "7" "$tcrc" >> "$OUT/phase_failures.tsv"
  RC_ANY=$tcrc
else
  echo "[JOB] === thetas vs the ticket-43 reference (REPORT ONLY, ~2% band) ==="
  cat "$OUT/theta_check49.tsv"
fi

# ---- the pair table for every two-surface cell, then the wall measurement and the k re-derivation
"$PY" "$INSTR/run_pair49.py" --out "$OUT" --cells "$OUT/cells-pipeline" --py "$PY" \
  > "$OUT/phase8_pairs49.log" 2>&1
prc=$?
[ -s "$OUT/phase8_pairs49.log" ] && tail -30 "$OUT/phase8_pairs49.log"
if [ "$prc" -eq 1 ]; then
  echo "[JOB] WARN run_pair49 rc=1 (a pair command failed -- see phase8_pairs49.log)"
  printf "%s\t%s\n" "8" "$prc" >> "$OUT/phase_failures.tsv"
  RC_ANY=$prc
elif [ "$prc" -eq 2 ]; then
  echo "[JOB] NOTE run_pair49 rc=2: no cell grew two surfaces, so there is no pair table (a result, recorded in surfaces49.tsv -- not a failure)"
  printf "%s\t%s\n" "8" "$prc" >> "$OUT/phase_failures.tsv"
fi
for T in pairs49.tsv nests49.tsv surfaces49.tsv; do
  if [ -f "$OUT/$T" ]; then
    echo "[JOB] === $T ==="
    cat "$OUT/$T"
  fi
done

# ---- measured wall thickness per piece, from the cell surfaces against the released mesh:
# the number the pair separation has to be compared with.  J2/J3/J5/J7/J9 have a measured wall
# from the earlier stages (2.693/2.452/2.900/3.263/2.595 mm) and wall49.py writes them into the
# table so the comparison is in one place.
"$PY" "$INSTR/wall49.py" --out "$OUT" --cells "$OUT/cells-pipeline" --ds "$DS" --corp "$CORP" \
  > "$OUT/phase8b_wall49.log" 2>&1
wrc=$?
[ -s "$OUT/phase8b_wall49.log" ] && tail -40 "$OUT/phase8b_wall49.log"
if [ "$wrc" -ne 0 ]; then
  echo "[JOB] WARN wall49 rc=$wrc (see phase8b_wall49.log)"
  printf "%s\t%s\n" "8b" "$wrc" >> "$OUT/phase_failures.tsv"
  RC_ANY=$wrc
fi
[ -f "$OUT/wall49.tsv" ] && { echo "[JOB] === wall49.tsv ==="; cat "$OUT/wall49.tsv"; }

# ---- k re-derivation: for pieces with a genuine wall pair, the k that puts the grown pair at
# wall separation, with spread and n, per vessel and pooled.  This is a FIT on the pieces it is
# then scored on -- the table says so; it is not a test.
"$PY" "$INSTR/k49.py" --out "$OUT" --pairs "$OUT/pairs49.tsv" --wall "$OUT/wall49.tsv" \
  --cells "$OUT/cells-pipeline/pipeline_cells.tsv" > "$OUT/phase8c_k49.log" 2>&1
krc=$?
[ -s "$OUT/phase8c_k49.log" ] && tail -40 "$OUT/phase8c_k49.log"
if [ "$krc" -ne 0 ]; then
  echo "[JOB] WARN k49 rc=$krc (see phase8c_k49.log)"
  printf "%s\t%s\n" "8c" "$krc" >> "$OUT/phase_failures.tsv"
  RC_ANY=$krc
fi
[ -f "$OUT/k49.tsv" ] && { echo "[JOB] === k49.tsv ==="; cat "$OUT/k49.tsv"; }

# ---- the eye picture: 3x3 panels per patch radius, corpus clouds and calibration clouds
"$PY" "$INSTR/figures49.py" --out "$OUT" --cells "$OUT/cells-pipeline" --ds "$DS" \
  > "$OUT/phase9_figures49.log" 2>&1
frc=$?
[ -s "$OUT/phase9_figures49.log" ] && tail -20 "$OUT/phase9_figures49.log"
if [ "$frc" -ne 0 ]; then
  echo "[JOB] WARN figures49 rc=$frc (no panel written -- see phase9_figures49.log)"
  printf "%s\t%s\n" "9" "$frc" >> "$OUT/phase_failures.tsv"
  RC_ANY=$frc
fi

# The closing bookkeeping runs once, and also on a termination signal: if Slurm ends this job at
# the wall clock, the corpus is still proved unchanged, the geometry is still counted, deleted and
# the index row still appended, so a timeout cannot leave half a record behind.
FINISHED=0
finish() {
  [ "$FINISHED" -eq 1 ] && return 0
  FINISHED=1
  corpus_tree "$OUT/corpus_after.tsv"
  md5_corpus "$OUT/inputs_after.md5"
  diff "$OUT/corpus_before.tsv" "$OUT/corpus_after.tsv" > "$OUT/corpus.diff" || true
  diff "$OUT/inputs_before.md5" "$OUT/inputs_after.md5" > "$OUT/inputs.diff" || true
  if [ -s "$OUT/corpus.diff" ] || [ -s "$OUT/inputs.diff" ]; then
    echo "[JOB] WARN the corpus or the frozen inputs changed during this job"
    cat "$OUT/corpus.diff" "$OUT/inputs.diff"
  else
    echo "[JOB] corpus and frozen inputs unchanged"
  fi

  geom_record "$OUT/geometry_counts.tsv"
  geom_delete

  {
    echo "runid=$RUNID"
    echo "jobid=$JOBID"
    echo "commit=$NEW"
    echo "tag=$IXTAG"
    echo "phase=$PHASE"
    echo "host=$(hostname)"
    echo "utc $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "phase_rc=$rc"
    echo "phase_failures=$(cat "$OUT/phase_failures.tsv" 2>/dev/null | tr "\n" " ")"
  } > "$OUT/run-meta.txt"

  printf "%s\t%s\t%s\t%s\t\t\n" "$RUNID" "$JOBID" "$NEW" "$IXTAG" >> "$IDX"
  echo "[JOB] index row appended (verdict and human_note left empty)"
}
trap 'echo "[JOB] signal caught: closing the record before exiting"; finish; exit 143' TERM INT

finish
if [ "$RC_ANY" -ne 0 ]; then
  echo "[JOB] FAILED: a phase driver returned non-zero"
  cat "$OUT/phase_failures.tsv" 2>/dev/null || true
  exit "$RC_ANY"
fi
echo "[JOB] phase $PHASE complete rc=0"
