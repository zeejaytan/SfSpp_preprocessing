#!/bin/bash
#SBATCH --job-name=__JOBNAME__
#SBATCH --account=punim2657
#SBATCH --partition=sapphire
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=__TIME__
#SBATCH --output=__RUNDIR__/logs/slurm-%j.out
#SBATCH --error=__RUNDIR__/logs/slurm-%j.err
# ticket 51 -- cap the growth angle by the piece's own measured cheapest crossing.
#
# One phase.  Source change (mesh_processing_headless.cpp, this commit): thetaCross51() -- k=11
# NN graph on downsampledCloudWithNormals, an edge is eligible only when BOTH endpoint
# curvatures are < 1.0, Kruskal ascending by the angle between normals (|dot|, degrees), and
# the crossing is the edge angle at which the largest component first reaches 60% of the points
# that carry >= 1 eligible edge; fewer than 1000 eligible points -> crossing=none, no cap.
# Gated by SFS_GROWTH_CAP=1 on top of the ticket-46 formula path:
#   phase 5  arms C+U on 17 pieces = 34 cells in one job:
#            C  SFS_GROWTH_FORMULA=1 SFS_GROWTH_CAP=1 -> paperTheta = min(formula, 0.9*crossing)
#               (logged [GROWTH-51] crossing=... capped=... theta=... right after [GROWTH-45]);
#            U  SFS_GROWTH_FORMULA=1 -> the uncapped control, identical to ticket 48's arm V.
#            Juglet 1-9 on the ticket-47 corpus-conforming clouds (md5 AND kept_points gated
#            against MANIFEST_JUGLET_CC.tsv by run_cell51.sh pass 1), Pot A 01-08 released
#            clouds as the unchanged control.
# thetas51.tsv rides along COMMITTED as the REFERENCE (t48 formula theta, t50 edge50 glue60
# k=10); the job reports against it -- REPORT ONLY, a miss is a result, never a gate.
#
# Paid-for traps this script is written around: CRLF in any script (grep gate in the submitter);
# brace-stripping when this template renders (unrendered-placeholder and expansion-count
# checks); unbound variables under set -u (every variable defaulted); no xargs -d; grep -a on
# binary PCD/PLY; PLY header length varies (instruments parse to end_header).
set -uo pipefail

RUN=__RUNDIR__
RUNID=__RUNID__
NEW=__NEWCOMMIT__
PHASE=__PHASE__
IXTAG=__IXTAG__
PARTA=__PARTA__
CANON=/data/gpfs/projects/punim2657/sfs_preprocessing
CORP=/data/gpfs/projects/punim2657/sfs_main/original_samples/SfS_pp
DS=$CANON/Dataset
SIF=$CANON/pcl_191_nurbs.sif
APT=/apps/easybuild-2022/easybuild/software/Compiler/GCCcore/11.3.0/Apptainer/1.3.3/bin/apptainer
PY=/data/gpfs/projects/punim2657/TORA/envs/tora/bin/python3
RINSTR=$RUN/instruments
OUT=$RUN/out
RUNS=/data/gpfs/projects/punim2657/SfSpp/runs
IDX=$RUNS/index.tsv
JOBID=$SLURM_JOB_ID; [ -n "$JOBID" ] || JOBID=na
P=$SLURM_CPUS_PER_TASK; [ -n "$P" ] || P=8
unset SFS_COUNT_SCALE SFS_SPACING_POLICY SFS_SPACING_SAMPLES SFS_NORMAL_SOURCE SFS_NORMAL_CARRY \
      SFS_SINGLE_CLUSTER SFS_FLOOR_CEILING SFS_DOWNSAMPLE_TARGET SFS_DUMP_STAGE SFS_DUMP_PIECES \
      SFS_PAPER_THETA SFS_PAPER_KAPPA SFS_PAPER_NB SFS_PAPER_CHAIN SFS_SMOOTHNESS_DEG \
      SFS_CURVATURE_THRESH SFS_REASSIGN_MODE SFS_WINDOW_REPORT SFS_MERGE_SCALE SFS_GROWTH_MODE \
      SFS_GROWTH_FORMULA SFS_GROWTH_CAP SFS_AXIS_FILE SFS_STATUS_FILE POT_NAME 2>/dev/null || true
export CANON CORP DS SIF APT PY OUT RUN RUNID NEW PHASE IXTAG PARTA RUNS IDX JOBID P

cd "$RUN" || exit 1
mkdir -p "$OUT" logs

fail() {
  local rc=$1; shift
  {
    echo "runid=$RUNID"
    echo "jobid=$JOBID"
    echo "commit=$NEW"
    echo "tag=$IXTAG"
    echo "rc=$rc"
    echo "reason: $*"
    date -u +"at %Y-%m-%dT%H:%M:%SZ"
  } > "$OUT/RUN-FAILED.txt"
  echo "[JOB] FATAL rc=$rc $* (see out/RUN-FAILED.txt)"
  exit "$rc"
}

echo "[JOB] runid=$RUNID job=$JOBID tag=$IXTAG phase=$PHASE new=$NEW host=$(hostname)"

git -C "$CANON" fetch --no-tags origin "+refs/heads/*:refs/remotes/origin/*" >> logs/fetch.log 2>&1
git -C "$CANON" rev-parse --verify --quiet "$NEW" > /dev/null 2>>logs/fetch.log || fail 2 "commit $NEW not in $CANON"

# the instruments the job executes are the PUSHED COMMIT bytes, not the run directory copies
SRC=$RUN/build/src
rm -rf "$SRC"; mkdir -p "$SRC"
# path-limited: the instruments are all this needs, and the full tree is ~1 GB of committed data
git -C "$CANON" archive "$NEW" .scratch/juglet-breaklines/stage51 | tar -x -C "$SRC" \
  || fail 3 "git archive $NEW failed"
INSTR=$SRC/.scratch/juglet-breaklines/stage51/instruments
[ -d "$INSTR" ] || fail 3 "no stage51 instruments in commit $NEW"
( cd "$INSTR" && md5sum *.py *.sh *.tsv 2>/dev/null ) | sort -k2 > "$OUT/instruments_commit.md5"
( cd "$RINSTR" && md5sum *.py *.sh *.tsv 2>/dev/null ) | sort -k2 > "$OUT/instruments_rundir.md5"
if ! diff -q "$OUT/instruments_commit.md5" "$OUT/instruments_rundir.md5" > /dev/null; then
  diff "$OUT/instruments_rundir.md5" "$OUT/instruments_commit.md5" || true
  fail 4 "instruments in the run directory differ from commit $NEW"
fi
echo "[JOB] instruments match commit $NEW ($(wc -l < "$OUT/instruments_commit.md5") files)"
STAGER=$INSTR/stage_synth_p40.sh
export INSTR STAGER

corpus_tree() {
  local out=$1
  {
    find "$CORP" -type f -printf "%p\t%s\t%T@" | sort
    find "$DS" -type f -printf "%p\t%s\t%T@" | sort
    if [ -d /opt/sfs-pristine ]; then
      echo "opt-sfs-pristine PRESENT $(ls -R /opt/sfs-pristine | md5sum | cut -d' ' -f1)"
    else
      echo "opt-sfs-pristine ABSENT"
    fi
  } > "$out"
}
pristine_record() {
  local out=$1
  {
    echo "# /opt/sfs-pristine, recorded from the compute node"
    if [ -d /opt/sfs-pristine ]; then
      echo "status PRESENT"; ls -la /opt/sfs-pristine
    else
      echo "status ABSENT"
      ls -d /opt/sfs-pristine 2>&1 || true
      stat /opt/sfs-pristine 2>&1 || true
    fi
  } > "$out"
}
md5_corpus() {
  local out=$1 f
  {
    for f in "$DS"/Point/Juglet/*.pcd "$DS"/Point/Juglet/MANIFEST_JUGLET_CC.tsv \
             "$DS"/Mesh/Juglet/*.obj "$DS"/Axes/Juglet/*.xyz \
             "$DS"/Point/Pot_A/*.pcd "$DS"/Axes/Pot_A/*.xyz \
             "$CORP"/Point/Pot_A/*.pcd "$CORP"/Mesh/Pot_A_Piece_*.obj "$CORP"/Axes/*.xyz; do
      [ -f "$f" ] && printf "%s\t%s\n" "$(md5sum "$f" | cut -d' ' -f1)" "$f"
    done
  } | sort -k2 > "$out"
}

corpus_tree "$OUT/corpus_before.tsv"
pristine_record "$OUT/pristine.txt"
md5_corpus "$OUT/inputs_before.md5"
{
  echo "host $(hostname)"
  echo "utc $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "commit $NEW"
  "$PY" -c "import numpy, scipy, sys; print('python', sys.version.split()[0]); print('numpy', numpy.__version__); print('scipy', scipy.__version__)" 2>&1
  "$APT" --version 2>&1 | head -2
  nproc
} > "$OUT/versions.txt" 2>&1
cat "$OUT/versions.txt"

build_bin() {
  local name=$1 sha=$2 rc
  echo "[BUILD] $name from $sha"
  mkdir -p "build/$name/src/build"
  git -C "$CANON" archive "$sha" | tar -x -C "build/$name/src" || { echo "[BUILD] archive FAILED"; return 1; }
  ( cd "build/$name/src/build" \
    && "$APT" exec --bind /data:/data "$SIF" cmake -DCMAKE_BUILD_TYPE=Release .. \
    && "$APT" exec --bind /data:/data "$SIF" make -j"$P" MeshPreprocessingHeadless \
  ) > "logs/build-$name.log" 2>&1
  rc=$?
  if [ "$rc" -eq 0 ] && [ -x "build/$name/src/build/MeshPreprocessingHeadless" ]; then
    cp -f "build/$name/src/build/MeshPreprocessingHeadless" "$OUT/bin-$name"
    echo "[BUILD] $name ok $(stat -c %s "$OUT/bin-$name") bytes md5=$(md5sum "$OUT/bin-$name" | cut -d' ' -f1)"
    return 0
  fi
  return 1
}

geom_record() {
  local out=$1
  {
    find "$OUT" -type f -printf "%p\t%s\n" 2>/dev/null | awk -F"\t" '
      { n=split($1,a,"."); ext=(n>1?a[n]:"none");
        if (ext !~ /^(pcd|ply|obj|xyz|stl|off)$/) next;
        f[ext]++; b[ext]+=$2; tf++; tb+=$2 }
      END { for (e in f) printf "%s\t%d\t%d\n", e, f[e], b[e];
            printf "TOTAL\t%d\t%d\n", tf, tb }'
  } | sort > "$out"
  cat "$out"
}
geom_delete() {
  # ticket 51 KEEPS the cells surfaces for the pair-quality table: everything else under out/
  # is deleted, and the delete records itself first -- what is kept is named, not implied.
  local before after kept
  before=$(find "$OUT" -type f \( -name "*.pcd" -o -name "*.ply" -o -name "*.obj" -o -name "*.xyz" \) | wc -l)
  kept=$(find "$OUT" -path "*/cells-pipeline/*/surfaces/*.ply" -type f | wc -l)
  find "$OUT" -type f \( -name "*.pcd" -o -name "*.ply" -o -name "*.obj" -o -name "*.xyz" \) \
    -not -path "*/cells-pipeline/*/surfaces/*" -print0 | xargs -0 -r rm -f
  rm -rf "$OUT"/cells-pipeline/stage_* 2>/dev/null || true
  after=$(find "$OUT" -type f \( -name "*.pcd" -o -name "*.ply" -o -name "*.obj" -o -name "*.xyz" \) | wc -l)
  {
    echo "# geometry deleted by $RUNID phase $PHASE, $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "geometry_files_before $before"
    echo "geometry_files_after $after"
    echo "kept_cell_surface_plies $kept"
    echo "# kept: the cells surfaces (*/cells-pipeline/*/surfaces/*.ply), tsv json log py sh txt"
  } > "$OUT/GEOMETRY_DELETED.txt"
  cat "$OUT/GEOMETRY_DELETED.txt"
}

JUG="Juglet_Piece_1 Juglet_Piece_2 Juglet_Piece_3 Juglet_Piece_4 Juglet_Piece_5 Juglet_Piece_6 Juglet_Piece_7 Juglet_Piece_8 Juglet_Piece_9"
POTA="Pot_A_Piece_01 Pot_A_Piece_02 Pot_A_Piece_03 Pot_A_Piece_04 Pot_A_Piece_05 Pot_A_Piece_06 Pot_A_Piece_07 Pot_A_Piece_08"

phase_cells() {  # phase 5 -> POT:PIECE:ARMS list: arms C+U everywhere
  local list="" pot pcs p
  for pot in Juglet Pot_A; do
    if [ "$pot" = "Juglet" ]; then pcs=$JUG; else pcs=$POTA; fi
    for p in $pcs; do
      list="$list $pot:$p:CU"
    done
  done
  echo "$list"
}

RC_ANY=0
rc=1
echo "[JOB] ---- phase $PHASE ----"
case "$PHASE" in
  5) ;;
  *) fail 6 "unknown phase $PHASE (ticket 51: 5 = arms C+U on 17 pieces)" ;;
esac

# ------------------------------------------------ the cells: arms C+U, corpus-gated
cp -f "$INSTR/thetas51.tsv" "$OUT/thetas_reference.tsv"
echo "[JOB] reference thetas committed with ticket 51 (md5 $(md5sum "$OUT/thetas_reference.tsv" | cut -d' ' -f1))"
cat "$OUT/thetas_reference.tsv"

build_bin new "$NEW" || fail 5 "binary build failed (see logs/build-new.log)"
BIN=$OUT/bin-new; export BIN
export CELL_LIST="$(phase_cells)" MIN_LEFT_S=300 CELL_BUDGET_S=2400
echo "[JOB] cells: $(echo $CELL_LIST | wc -w) POT:PIECE:ARMS specs"
bash "$INSTR/run_cell51.sh" > "$OUT/phase5_cells.log" 2>&1; rc=$?
[ -s "$OUT/phase5_cells.log" ] && tail -100 "$OUT/phase5_cells.log"
if [ "$rc" -ne 0 ]; then
  echo "[JOB] WARN the cells driver failed rc=$rc (see the cells log); closing record still written"
  printf "%s\t%s\n" "5" "$rc" >> "$OUT/phase_failures.tsv"
  RC_ANY=$rc
fi

# ---- the thetas table (mechanical) + reference checks (REPORT ONLY): arm-U theta_formula vs
# t48 to 2 dp, arm-C crossing vs edge50 glue60 k=10 within 1.5 deg.  Nonzero rc means the table
# could not be produced at all -- a broken measurement, not a prediction miss.
"$PY" "$INSTR/thetas51.py" --cells "$OUT/cells-pipeline" --ref "$INSTR/thetas51.tsv" \
  --out "$OUT/thetas51.tsv" --check-out "$OUT/theta_check51.tsv" > "$OUT/phase6_thetas51.log" 2>&1
trc=$?
[ -s "$OUT/phase6_thetas51.log" ] && tail -50 "$OUT/phase6_thetas51.log"
if [ "$trc" -ne 0 ]; then
  echo "[JOB] WARN thetas51 rc=$trc (no thetas table produced -- see phase6_thetas51.log)"
  printf "%s\t%s\n" "6" "$trc" >> "$OUT/phase_failures.tsv"
  RC_ANY=$trc
fi

# ---- the pair-quality table (stage44/t50 protocol) on every two-surface cell
"$PY" "$INSTR/pairquality51.py" --cells "$OUT/cells-pipeline" --out "$OUT/pairquality51.tsv" \
  > "$OUT/phase7_pairq51.log" 2>&1
prc=$?
[ -s "$OUT/phase7_pairq51.log" ] && tail -50 "$OUT/phase7_pairq51.log"
if [ "$prc" -ne 0 ]; then
  echo "[JOB] WARN pairquality51 rc=$prc (no pair table -- see phase7_pairq51.log)"
  printf "%s\t%s\n" "7" "$prc" >> "$OUT/phase_failures.tsv"
  RC_ANY=$prc
fi

# The closing bookkeeping runs once, and also on a termination signal: if Slurm ends this job at
# the wall clock, the corpus is still proved unchanged, the geometry is still counted, deleted
# and the index row still appended, so a timeout cannot leave half a record behind.
FINISHED=0
finish() {
  [ "$FINISHED" -eq 1 ] && return 0
  FINISHED=1
  corpus_tree "$OUT/corpus_after.tsv"
  md5_corpus "$OUT/inputs_after.md5"
  diff "$OUT/corpus_before.tsv" "$OUT/corpus_after.tsv" > "$OUT/corpus.diff" || true
  diff "$OUT/inputs_before.md5" "$OUT/inputs_after.md5" > "$OUT/inputs.diff" || true
  if [ -s "$OUT/corpus.diff" ] || [ -s "$OUT/inputs.diff" ]; then
    echo "[JOB] WARN the corpus or the frozen inputs changed during this job"
    cat "$OUT/corpus.diff" "$OUT/inputs.diff"
  else
    echo "[JOB] corpus and frozen inputs unchanged"
  fi

  geom_record "$OUT/geometry_counts.tsv"
  geom_delete

  {
    echo "runid=$RUNID"
    echo "jobid=$JOBID"
    echo "commit=$NEW"
    echo "tag=$IXTAG"
    echo "phase=$PHASE"
    echo "host=$(hostname)"
    echo "utc $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "phase_rc=$rc"
    echo "phase_failures=$(cat "$OUT/phase_failures.tsv" 2>/dev/null | tr "\n" " ")"
  } > "$OUT/run-meta.txt"

  printf "%s\t%s\t%s\t%s\t\t\n" "$RUNID" "$JOBID" "$NEW" "$IXTAG" >> "$IDX"
  echo "[JOB] index row appended (verdict and human_note left empty)"
}
trap 'echo "[JOB] signal caught: closing the record before exiting"; finish; exit 143' TERM INT

finish
if [ "$RC_ANY" -ne 0 ]; then
  echo "[JOB] FAILED: a phase driver returned non-zero"
  cat "$OUT/phase_failures.tsv" 2>/dev/null || true
  exit "$RC_ANY"
fi
echo "[JOB] phase $PHASE complete rc=0"
