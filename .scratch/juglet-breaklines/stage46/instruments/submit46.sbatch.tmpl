#!/bin/bash
#SBATCH --job-name=__JOBNAME__
#SBATCH --account=punim2657
#SBATCH --partition=sapphire
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=__TIME__
#SBATCH --output=__RUNDIR__/logs/slurm-%j.out
#SBATCH --error=__RUNDIR__/logs/slurm-%j.err
# ticket 46 -- feed the growth an even covering of the piece's own shipped mesh.
#
# NOT the paper's method (the paper resamples the BREAKLINE at 1.9 mm, ticket 06) and NOT a
# source change: this run asks whether the growth angle the pipeline computes is a property of
# the PIECE or of the cloud it happens to read.  Ticket 45 measured the angle on the corpus
# clouds (2,094-24,294 points on the Juglet) and got 18.7-54.4 deg against a formula prediction
# of 8.2-12.7; the same code on a proper covering of the same mesh reproduces the prediction.
# So nine Juglet cells read an EVEN COVERING of their own shipped mesh at the spacing the run
# already resolves (S per piece from spec46.tsv -- one S per piece, not a per-piece tuning), and
# eight Pot A cells read their released clouds as the control.  SFS_PAPER_THETA and
# SFS_GROWTH_MODE are unset in every cell; run_cell46.sh proves it per cell in env_proof.tsv.
#   phase 1  cover_cloud46.py on the nine Juglet pieces (spacing within 1 pct, every point
#            within 1e-3 mm of the mesh, no subdivision used)
#   phase 4  the seventeen cells; the covering gate stops the run before any cell if it failed
#   phase 7  theta_check46.py: theta against ticket 43's k-rule (2 pct) and against ticket 45's
#            arm-F measurement
#   phase 8  run_measure34.py: the pair table of whatever grew two surfaces
#   phase 9  figures46.py: the two eye pictures
# PHASE=all runs 1, 4, 7, 8, 9 in order in one job.
#
# Paid-for traps this script is written around: CRLF in any script (grep gate in the submitter);
# brace-stripping when this template renders (unrendered-placeholder and expansion-count checks);
# unbound variables under set -u (every variable defaulted, no ${...} form is used anywhere);
# no xargs -d; grep -a on binary PCD/PLY; PLY header length varies (instruments parse to
# end_header); a skipped cell must print the same field count as the header.
set -uo pipefail

RUN=__RUNDIR__
RUNID=__RUNID__
NEW=__NEWCOMMIT__
PHASE=__PHASE__
IXTAG=__IXTAG__
PARTA=__PARTA__
CANON=/data/gpfs/projects/punim2657/sfs_preprocessing
CORP=/data/gpfs/projects/punim2657/sfs_main/original_samples/SfS_pp
DS=$CANON/Dataset
SIF=$CANON/pcl_191_nurbs.sif
APT=/apps/easybuild-2022/easybuild/software/Compiler/GCCcore/11.3.0/Apptainer/1.3.3/bin/apptainer
PY=/data/gpfs/projects/punim2657/TORA/envs/tora/bin/python3
RINSTR=$RUN/instruments
OUT=$RUN/out
COVER=$OUT/cells-covering
RUNS=/data/gpfs/projects/punim2657/SfSpp/runs
IDX=$RUNS/index.tsv
JOBID=$SLURM_JOB_ID; [ -n "$JOBID" ] || JOBID=na
P=$SLURM_CPUS_PER_TASK; [ -n "$P" ] || P=8
unset SFS_COUNT_SCALE SFS_SPACING_POLICY SFS_SPACING_SAMPLES SFS_NORMAL_SOURCE SFS_NORMAL_CARRY \
      SFS_SINGLE_CLUSTER SFS_FLOOR_CEILING SFS_DOWNSAMPLE_TARGET SFS_DUMP_STAGE SFS_DUMP_PIECES \
      SFS_PAPER_THETA SFS_PAPER_KAPPA SFS_PAPER_NB SFS_PAPER_CHAIN SFS_SMOOTHNESS_DEG \
      SFS_CURVATURE_THRESH SFS_REASSIGN_MODE SFS_WINDOW_REPORT SFS_MERGE_SCALE SFS_GROWTH_MODE \
      SFS_AXIS_FILE SFS_STATUS_FILE POT_NAME 2>/dev/null || true
export CANON CORP DS COVER SIF APT PY OUT RUN RUNID NEW PHASE IXTAG PARTA RUNS IDX JOBID P

cd "$RUN" || exit 1
mkdir -p "$OUT" logs

fail() {
  local rc=$1; shift
  {
    echo "runid=$RUNID"
    echo "jobid=$JOBID"
    echo "commit=$NEW"
    echo "tag=$IXTAG"
    echo "rc=$rc"
    echo "reason: $*"
    date -u +"at %Y-%m-%dT%H:%M:%SZ"
  } > "$OUT/RUN-FAILED.txt"
  echo "[JOB] FATAL rc=$rc $* (see out/RUN-FAILED.txt)"
  exit "$rc"
}

echo "[JOB] runid=$RUNID job=$JOBID tag=$IXTAG phase=$PHASE new=$NEW host=$(hostname)"

git -C "$CANON" fetch --no-tags origin "+refs/heads/*:refs/remotes/origin/*" >> logs/fetch.log 2>&1
git -C "$CANON" rev-parse --verify --quiet "$NEW" > /dev/null 2>>logs/fetch.log || fail 2 "commit $NEW not in $CANON"

# the instruments the job executes are the PUSHED COMMIT bytes, not the run directory copies
SRC=$RUN/build/src
rm -rf "$SRC"; mkdir -p "$SRC"
# path-limited: the instruments are all this needs, and the full tree is ~1 GB of committed data
git -C "$CANON" archive "$NEW" .scratch/juglet-breaklines/stage46 | tar -x -C "$SRC" \
  || fail 3 "git archive $NEW failed"
INSTR=$SRC/.scratch/juglet-breaklines/stage46/instruments
[ -d "$INSTR" ] || fail 3 "no stage46 instruments in commit $NEW"
( cd "$INSTR" && md5sum *.py *.sh *.tsv 2>/dev/null ) | sort -k2 > "$OUT/instruments_commit.md5"
( cd "$RINSTR" && md5sum *.py *.sh *.tsv 2>/dev/null ) | sort -k2 > "$OUT/instruments_rundir.md5"
if ! diff -q "$OUT/instruments_commit.md5" "$OUT/instruments_rundir.md5" > /dev/null; then
  diff "$OUT/instruments_rundir.md5" "$OUT/instruments_commit.md5" || true
  fail 4 "instruments in the run directory differ from commit $NEW"
fi
echo "[JOB] instruments match commit $NEW ($(wc -l < "$OUT/instruments_commit.md5") files)"
STAGER=$INSTR/stage_synth_p40.sh
export INSTR STAGER

corpus_tree() {
  local out=$1
  {
    find "$CORP" -type f -printf "%p\t%s\t%T@\n" | sort
    find "$DS" -type f -printf "%p\t%s\t%T@\n" | sort
    if [ -d /opt/sfs-pristine ]; then
      echo "opt-sfs-pristine PRESENT $(ls -R /opt/sfs-pristine | md5sum | cut -d' ' -f1)"
    else
      echo "opt-sfs-pristine ABSENT"
    fi
  } > "$out"
}
pristine_record() {
  local out=$1
  {
    echo "# /opt/sfs-pristine, recorded from the compute node"
    if [ -d /opt/sfs-pristine ]; then
      echo "status PRESENT"; ls -la /opt/sfs-pristine
    else
      echo "status ABSENT"
      ls -d /opt/sfs-pristine 2>&1 || true
      stat /opt/sfs-pristine 2>&1 || true
    fi
  } > "$out"
}
md5_corpus() {
  local out=$1 f
  {
    for f in "$DS"/Point/Juglet/*.pcd "$DS"/Mesh/Juglet/*.obj "$DS"/Axes/Juglet/*.xyz \
             "$DS"/Axes/Pot_A/*.xyz \
             "$CORP"/Point/Pot_A/*.pcd "$CORP"/Mesh/Pot_A_Piece_*.obj "$CORP"/Axes/*.xyz; do
      [ -f "$f" ] && printf "%s\t%s\n" "$(md5sum "$f" | cut -d' ' -f1)" "$f"
    done
  } | sort -k2 > "$out"
}

corpus_tree "$OUT/corpus_before.tsv"
pristine_record "$OUT/pristine.txt"
md5_corpus "$OUT/inputs_before.md5"
{
  echo "host $(hostname)"
  echo "utc $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "commit $NEW"
  "$PY" -c "import numpy, scipy, sys; print('python', sys.version.split()[0]); print('numpy', numpy.__version__); print('scipy', scipy.__version__)" 2>&1
  "$PY" -c "import matplotlib; print('matplotlib', matplotlib.__version__)" 2>&1 || echo "matplotlib absent"
  "$APT" --version 2>&1 | head -2
  nproc
} > "$OUT/versions.txt" 2>&1
cat "$OUT/versions.txt"

build_bin() {
  local name=$1 sha=$2 rc
  echo "[BUILD] $name from $sha"
  mkdir -p "build/$name/src/build"
  git -C "$CANON" archive "$sha" | tar -x -C "build/$name/src" || { echo "[BUILD] archive FAILED"; return 1; }
  ( cd "build/$name/src/build" \
    && "$APT" exec --bind /data:/data "$SIF" cmake -DCMAKE_BUILD_TYPE=Release .. \
    && "$APT" exec --bind /data:/data "$SIF" make -j"$P" MeshPreprocessingHeadless \
  ) > "logs/build-$name.log" 2>&1
  rc=$?
  if [ "$rc" -eq 0 ] && [ -x "build/$name/src/build/MeshPreprocessingHeadless" ]; then
    cp -f "build/$name/src/build/MeshPreprocessingHeadless" "$OUT/bin-$name"
    echo "[BUILD] $name ok $(stat -c %s "$OUT/bin-$name") bytes md5=$(md5sum "$OUT/bin-$name" | cut -d' ' -f1)"
    return 0
  fi
  return 1
}

geom_record() {
  local out=$1
  {
    find "$OUT" -type f -printf "%p\t%s\n" 2>/dev/null | awk -F"\t" '
      { n=split($1,a,"."); ext=(n>1?a[n]:"none");
        if (ext !~ /^(pcd|ply|obj|xyz|stl|off)$/) next;
        f[ext]++; b[ext]+=$2; tf++; tb+=$2 }
      END { for (e in f) printf "%s\t%d\t%d\n", e, f[e], b[e];
            printf "TOTAL\t%d\t%d\n", tf, tb }'
  } | sort > "$out"
  cat "$out"
}
geom_delete() {
  # ticket 45 KEEPS the cells surfaces for the lead: everything else under out/ is deleted, and
  # the delete records itself first -- what is kept is named in the record, not implied.
  local before after kept
  before=$(find "$OUT" -type f \( -name "*.pcd" -o -name "*.ply" -o -name "*.obj" -o -name "*.xyz" \) | wc -l)
  kept=$(find "$OUT" -path "*/cells-pipeline/*/surfaces/*.ply" -type f | wc -l)
  cover=$(find "$OUT" -path "*/cells-covering/*" -type f -name "*.pcd" | wc -l)
  find "$OUT" -type f \( -name "*.pcd" -o -name "*.ply" -o -name "*.obj" -o -name "*.xyz" \) \
    -not -path "*/cells-pipeline/*/surfaces/*" -not -path "*/cells-covering/*" -print0 | xargs -0 -r rm -f
  rm -rf "$OUT"/cells-pipeline/stage_* 2>/dev/null || true
  after=$(find "$OUT" -type f \( -name "*.pcd" -o -name "*.ply" -o -name "*.obj" -o -name "*.xyz" \) | wc -l)
  {
    echo "# geometry deleted by $RUNID phase $PHASE, $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "geometry_files_before $before"
    echo "geometry_files_after $after"
    echo "kept_cell_surface_plies $kept"
    echo "kept_coverings_until_phase9 $cover"
    echo "# kept: the cells surfaces (*/cells-pipeline/*/surfaces/*.ply), tsv json log py sh txt png"
  } > "$OUT/GEOMETRY_DELETED.txt"
  cat "$OUT/GEOMETRY_DELETED.txt"
}

JUG="Juglet_Piece_1 Juglet_Piece_2 Juglet_Piece_3 Juglet_Piece_4 Juglet_Piece_5 Juglet_Piece_6 Juglet_Piece_7 Juglet_Piece_8 Juglet_Piece_9"
POTA="Pot_A_Piece_01 Pot_A_Piece_02 Pot_A_Piece_03 Pot_A_Piece_04 Pot_A_Piece_05 Pot_A_Piece_06 Pot_A_Piece_07 Pot_A_Piece_08"

phase_cells() {  # phase 4 -> POT:PIECE:ARMS; the Juglet reads its covering (E), Pot A its released cloud (A)
  local list="" p
  for p in $JUG;  do list="$list Juglet:$p:E"; done
  for p in $POTA; do list="$list Pot_A:$p:A"; done
  echo "$list"
}

RC_ANY=0
rc=1
echo "[JOB] ---- phase $PHASE ----"
case "$PHASE" in
  1|4|7|8|9|all) ;;
  *) fail 6 "unknown phase $PHASE (ticket 46: 1 = coverings, 4 = cells, 7 = theta check, 8 = pair table, 9 = pictures, all = 1,4,7,8,9 in order)" ;;
esac
want() { [ "$PHASE" = "all" ] || [ "$PHASE" = "$1" ]; }

# ------------------------------------------------ phase 1: an even covering of each Juglet piece
if want 1; then
  SPECF=$INSTR/spec46.tsv
  [ -f "$SPECF" ] || fail 7 "no spec46.tsv in the instruments"
  cp -f "$SPECF" "$OUT/spec46_committed.tsv"
  echo "[JOB] spec46 md5 $(md5sum "$SPECF" | cut -d' ' -f1)"
  cat "$SPECF"
  mkdir -p "$COVER"
  RC1=0; NCC=0
  for P in $JUG; do
    S=$(awk -F'\t' -v p="$P" 'NR>1 && $2==p {print $3; exit}' "$SPECF")
    MESH=$DS/Mesh/Juglet/"$P"_Mesh.obj
    SHIP=$DS/Point/Juglet/"$P"_Point.pcd
    if [ -z "$S" ] || [ ! -f "$MESH" ] || [ ! -f "$SHIP" ]; then
      echo "[COVER] FATAL $P: S='$S' mesh=$MESH shipped=$SHIP"
      RC1=1; printf "%s\t%s\n" "1:$P/input" "1" >> "$OUT/phase_failures.tsv"; continue
    fi
    echo "[COVER] $P S=$S"
    "$PY" "$INSTR/cover_cloud46.py" --mesh "$MESH" --shipped-cloud "$SHIP" --spacing "$S" \
      --piece "$P" --out "$COVER/$P"_covering.pcd --json "$COVER/$P"_cover.json \
      > "$OUT/cover_$P.log" 2>&1
    rc=$?
    tail -12 "$OUT/cover_$P.log" || true
    if [ "$rc" -eq 0 ]; then
      NCC=$((NCC+1))
    else
      echo "[COVER] FAILED $P rc=$rc"
      RC1=$rc; printf "%s\t%s\n" "1:$P" "$rc" >> "$OUT/phase_failures.tsv"
    fi
  done
  echo "[JOB] coverings built: $NCC of 9"
  [ "$RC1" -eq 0 ] || RC_ANY=$RC1
fi

# ------------------------------------------------ phase 4: the seventeen cells, no env anywhere
if want 4; then
  build_bin new "$NEW" || fail 5 "binary build failed (see logs/build-new.log)"
  BIN=$OUT/bin-new; export BIN
  export CELL_LIST="$(phase_cells)" MIN_LEFT_S=300 CELL_BUDGET_S=7200
  echo "[JOB] cells: $CELL_LIST"
  bash "$INSTR/run_cell46.sh" > "$OUT/phase4_cells.log" 2>&1; rc=$?
  [ -s "$OUT/phase4_cells.log" ] && tail -120 "$OUT/phase4_cells.log"
  if [ "$rc" -ne 0 ]; then
    echo "[JOB] WARN the cells driver returned rc=$rc (see the cells log); the closing record is still written"
    printf "%s\t%s\n" "4" "$rc" >> "$OUT/phase_failures.tsv"
    RC_ANY=$rc
  fi
fi

# ------------------------------------------------ phase 7: theta against both references
if want 7; then
  CELLS=$OUT/cells-pipeline/pipeline_cells.tsv
  if [ ! -f "$CELLS" ]; then
    echo "[JOB] no $CELLS -- phase 4 must run first"
    printf "%s\t%s\n" "7/no-cells" "1" >> "$OUT/phase_failures.tsv"; RC_ANY=1
  else
    "$PY" "$INSTR/theta_check46.py" --cells "$CELLS" --spec "$INSTR/spec46.tsv" --out "$OUT" > "$OUT/phase7_theta.log" 2>&1
    rc=$?
    cat "$OUT/phase7_theta.log"
    echo "[JOB] theta_check rc=$rc (0 pass, 3 theta off, 4 missing piece, 5 control moved, 6 no theta)"
    [ "$rc" -eq 0 ] || { RC_ANY=$rc; printf "%s\t%s\n" "7" "$rc" >> "$OUT/phase_failures.tsv"; }
  fi
fi

# ------------------------------------------------ phase 8: the pair table of whatever grew two
if want 8; then
  "$PY" "$INSTR/run_measure34.py" --out "$OUT" --cells "$OUT/cells-pipeline" --cover "$COVER" \
    --spec "$INSTR/spec46.tsv" --corp "$CORP" --ds "$DS" --py "$PY" > "$OUT/phase8_pairs.log" 2>&1
  rc=$?
  tail -60 "$OUT/phase8_pairs.log"
  echo "[JOB] measure rc=$rc (0 ok, 1 a cell failed to measure, 2 no pair rows)"
  [ "$rc" -eq 0 ] || { RC_ANY=$rc; printf "%s\t%s\n" "8" "$rc" >> "$OUT/phase_failures.tsv"; }
fi

# ------------------------------------------------ phase 9: the two pictures
if want 9; then
  "$PY" "$INSTR/figures46.py" --out "$OUT" --cells "$OUT/cells-pipeline" --cover "$COVER" \
    --ds "$DS" > "$OUT/phase9_figures.log" 2>&1
  rc=$?
  cat "$OUT/phase9_figures.log"
  ls -l "$OUT/figures" 2>/dev/null || true
  [ "$rc" -eq 0 ] || { RC_ANY=$rc; printf "%s\t%s\n" "9" "$rc" >> "$OUT/phase_failures.tsv"; }
fi

# The closing bookkeeping runs once, and also on a termination signal: if Slurm ends this job at
# the wall clock, the corpus is still proved unchanged, the geometry is still counted, deleted
# and the index row still appended, so a timeout cannot leave half a record behind.
FINISHED=0
finish() {
  [ "$FINISHED" -eq 1 ] && return 0
  FINISHED=1
  corpus_tree "$OUT/corpus_after.tsv"
  md5_corpus "$OUT/inputs_after.md5"
  diff "$OUT/corpus_before.tsv" "$OUT/corpus_after.tsv" > "$OUT/corpus.diff" || true
  diff "$OUT/inputs_before.md5" "$OUT/inputs_after.md5" > "$OUT/inputs.diff" || true
  if [ -s "$OUT/corpus.diff" ] || [ -s "$OUT/inputs.diff" ]; then
    echo "[JOB] WARN the corpus or the frozen inputs changed during this job"
    cat "$OUT/corpus.diff" "$OUT/inputs.diff"
  else
    echo "[JOB] corpus and frozen inputs unchanged"
  fi

  # the coverings are the inputs of the pictures: they live until phase 9 has drawn, then go
  if want 9 && [ -d "$COVER" ]; then
    CN=$(find "$COVER" -type f -name "*.pcd" | wc -l)
    echo "[JOB] deleting $CN covering pcd now that the pictures are drawn"
    find "$COVER" -type f -name "*.pcd" -print0 | xargs -0 -r rm -f
  fi
  geom_record "$OUT/geometry_counts.tsv"
  geom_delete

  {
    echo "runid=$RUNID"
    echo "jobid=$JOBID"
    echo "commit=$NEW"
    echo "tag=$IXTAG"
    echo "phase=$PHASE"
    echo "host=$(hostname)"
    echo "utc $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "phase_rc=$rc"
    echo "phase_failures=$(cat "$OUT/phase_failures.tsv" 2>/dev/null | tr "\n" " ")"
  } > "$OUT/run-meta.txt"

  printf "%s\t%s\t%s\t%s\t\t\n" "$RUNID" "$JOBID" "$NEW" "$IXTAG" >> "$IDX"
  echo "[JOB] index row appended (verdict and human_note left empty)"
}
trap 'echo "[JOB] signal caught: closing the record before exiting"; finish; exit 143' TERM INT

finish
if [ "$RC_ANY" -ne 0 ]; then
  echo "[JOB] FAILED: the phase driver returned non-zero"
  cat "$OUT/phase_failures.tsv" 2>/dev/null || true
  exit "$RC_ANY"
fi
echo "[JOB] phase $PHASE complete rc=0"
