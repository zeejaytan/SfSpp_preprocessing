#!/bin/bash
#SBATCH --job-name=__JOBNAME__
#SBATCH --account=punim2657
#SBATCH --partition=sapphire
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=__TIME__
#SBATCH --output=__RUNDIR__/logs/slurm-%j.out
#SBATCH --error=__RUNDIR__/logs/slurm-%j.err
# ticket 33 -- keep the normals the scan already carries, and let the merge work on fragments.
# Builds the pipeline from the pre-change commit (ORIG) and from this ticket's commit (NEW) and
# runs a 6 pieces x 6 arms grid through it on the compute node.  Arms:
#   AO  ORIG binary, no switches        the defaults proof, reference side
#   A   NEW  binary, no switches        the defaults proof, tested side
#   A2  NEW  binary, no switches again  the piece's own run-to-run spread
#   B   SFS_NORMAL_SOURCE=input
#   C   SFS_NORMAL_SOURCE=input + the floor forced down through ticket 23's switches
#   D   C + SFS_MERGE_MIN_PAIRS=2
set -uo pipefail

RUN=__RUNDIR__
RUNID=__RUNID__
NEW=__NEWCOMMIT__
ORIG=__ORIGCOMMIT__
IXTAG=__IXTAG__
CANON=/data/gpfs/projects/punim2657/sfs_preprocessing
CORP=/data/gpfs/projects/punim2657/sfs_main/original_samples/SfS_pp
DS=$CANON/Dataset
BOOT=__BOOT__
SIF=$CANON/pcl_191_nurbs.sif
APT=/apps/easybuild-2022/easybuild/software/Compiler/GCCcore/11.3.0/Apptainer/1.3.3/bin/apptainer
PY=/data/gpfs/projects/punim2657/TORA/envs/tora/bin/python3
INSTR=$RUN/instruments
OUT=$RUN/out
ECELLS=$OUT/cells
RUNS=/data/gpfs/projects/punim2657/SfSpp/runs
IDX=$RUNS/index.tsv
JOBID=${SLURM_JOB_ID:-na}
P=${SLURM_CPUS_PER_TASK:-8}
export CANON CORP DS BOOT SIF APT PY INSTR OUT ECELLS RUN RUNID NEW ORIG IXTAG RUNS IDX JOBID P

cd "$RUN" || exit 1
mkdir -p "$OUT" "$ECELLS" logs

fail() {
  local rc=$1; shift
  {
    echo "runid=$RUNID"
    echo "jobid=$JOBID"
    echo "commit=$NEW"
    echo "orig=$ORIG"
    echo "tag=$IXTAG"
    echo "rc=$rc"
    echo "reason: $*"
    date -u +"at %Y-%m-%dT%H:%M:%SZ"
  } > "$OUT/RUN-FAILED.txt"
  echo "[JOB] FATAL rc=$rc $* (see out/RUN-FAILED.txt)"
  exit "$rc"
}

echo "[JOB] runid=$RUNID job=$JOBID tag=$IXTAG new=$NEW orig=$ORIG host=$(hostname)"
date -u +"start %Y-%m-%dT%H:%M:%SZ"

git -C "$CANON" fetch --no-tags origin "+refs/heads/*:refs/remotes/origin/*" >> logs/fetch.log 2>&1
for S in "$NEW" "$ORIG"; do
  if ! git -C "$CANON" cat-file -e "${S}^{commit}" 2>>logs/fetch.log; then
    fail 2 "commit $S not in $CANON"
  fi
done
echo "[JOB] commits ok new=$(git -C "$CANON" rev-parse --short "$NEW") orig=$(git -C "$CANON" rev-parse --short "$ORIG")"

hash_inputs() {
  local out=$1 f
  {
    for f in "$DS"/Point/Juglet/*.pcd "$DS"/Mesh/Juglet/*.obj \
             "$CORP"/Point/Pot_A/*.pcd "$CORP"/Mesh/Pot_A/*.obj \
             "$CORP"/Axes/*.xyz "$BOOT"/*_boot_Axis.xyz \
             "$SIF" "$INSTR"/measure33.py "$INSTR"/run_cell33.sh \
             "$INSTR"/stage_piece_p33.sh; do
      if [ -f "$f" ]; then
        printf "%s\t%s\t%s\n" "$(md5sum "$f" | cut -d' ' -f1)" "$(stat -c %s "$f")" "$f"
      else
        printf "MISSING\t0\t%s\n" "$f"
      fi
    done
  } | sort -k3 > "$out"
}

corpus_tree() {
  local out=$1
  {
    find "$CORP" -type f -printf "%p\t%s\t%T@\n" | sort
    find "$DS" -type f -printf "%p\t%s\t%T@\n" | sort
    if [ -d /opt/sfs-pristine ]; then
      echo "opt-sfs-pristine PRESENT $(ls -R /opt/sfs-pristine | md5sum | cut -d' ' -f1)"
    else
      echo "opt-sfs-pristine ABSENT"
    fi
  } > "$out"
}

pristine_record() {
  local out=$1
  {
    echo "# /opt/sfs-pristine, recorded from the compute node"
    if [ -d /opt/sfs-pristine ]; then
      echo "status PRESENT"
      ls -la /opt/sfs-pristine
    else
      echo "status ABSENT"
      ls -d /opt/sfs-pristine 2>&1 || true
      stat /opt/sfs-pristine 2>&1 || true
    fi
  } > "$out"
}

build_arm() {
  local name=$1 sha=$2 rc
  echo "[BUILD] $name from $sha"
  mkdir -p "build/$name/src/build"
  git -C "$CANON" archive "$sha" | tar -x -C "build/$name/src" || { echo "[BUILD] archive FAILED $sha"; return 1; }
  ( cd "build/$name/src/build" \
    && "$APT" exec --bind /data:/data "$SIF" cmake -DCMAKE_BUILD_TYPE=Release .. \
    && "$APT" exec --bind /data:/data "$SIF" make -j"$P" MeshPreprocessingHeadless \
  ) > "logs/build-$name.log" 2>&1
  rc=$?
  if [ "$rc" -eq 0 ] && [ -x "build/$name/src/build/MeshPreprocessingHeadless" ]; then
    cp -f "build/$name/src/build/MeshPreprocessingHeadless" "$OUT/bin-$name"
    echo "[BUILD] $name ok $(stat -c %s "$OUT/bin-$name") bytes"
    return 0
  fi
  echo "[BUILD] $name FAILED rc=$rc -- tail of logs/build-$name.log:"
  tail -30 "logs/build-$name.log"
  return 1
}

run_cell_one() {
  local line="$1" tag pot piece
  [ -n "${line:-}" ] || return 0
  read -r tag pot piece <<< "$line"
  POT="$pot"; PIECE="$piece"; TAG="$tag"
  CEIL_LADDER=""
  case "$tag" in
    AO) BIN="$OUT/bin-orig"; ENVS="" ;;
    A)  BIN="$OUT/bin-new";  ENVS="" ;;
    A2) BIN="$OUT/bin-new";  ENVS="" ;;
    B)  BIN="$OUT/bin-new";  ENVS="SFS_NORMAL_SOURCE=input" ;;
    C)  BIN="$OUT/bin-new";  ENVS="SFS_NORMAL_SOURCE=input SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200 SFS_COUNT_SCALE=auto";
        CEIL_LADDER="0.02 0.015 0.01 0.0075 0.005" ;;
    D)  BIN="$OUT/bin-new";  ENVS="SFS_NORMAL_SOURCE=input SFS_MERGE_MIN_PAIRS=2 SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200 SFS_COUNT_SCALE=auto";
        CEIL_LADDER="0.02 0.015 0.01 0.0075 0.005" ;;
    *) echo "[CELL] unknown arm $tag in spec $line"; return 9 ;;
  esac
  if [ "$pot" = "Pot_A" ]; then AXIS="$CORP/Axes/${piece}_Axis.xyz"
  else AXIS="$BOOT/${piece}_boot_Axis.xyz"; fi
  STAGER="$INSTR/stage_piece_p33.sh"
  COMMIT="$NEW"
  CELLROOT="$ECELLS"
  MEAS="$INSTR/measure33.py"
  export POT PIECE TAG BIN ENVS AXIS STAGER COMMIT CELLROOT MEAS CEIL_LADDER
  bash "$INSTR/run_cell33.sh" "$tag"
}
export -f run_cell_one

hash_inputs "$OUT/inputs_before.md5"
corpus_tree "$OUT/corpus_before.txt"
pristine_record "$OUT/pristine.txt"
echo "[JOB] inputs hashed: $(wc -l < "$OUT/inputs_before.md5") rows, tree $(wc -l < "$OUT/corpus_before.txt") rows"
grep -m1 "opt-sfs-pristine" "$OUT/corpus_before.txt" || true
cat "$OUT/pristine.txt"

echo "[JOB] instrument selftest"
"$PY" "$INSTR/measure33.py" selftest 2>&1 | tee logs/selftest.log
SRC_RC=${PIPESTATUS[0]}
[ "$SRC_RC" -eq 0 ] || fail 5 "measure33.py selftest rc=$SRC_RC (logs/selftest.log); no measurement was taken"

echo "[JOB] build the pipeline from $ORIG (pre-change) and $NEW"
build_arm orig "$ORIG" || fail 3 "the pre-change commit did not build; see logs/build-orig.log"
build_arm new "$NEW" || fail 4 "this ticket's commit did not build; see logs/build-new.log"

PIECES="Juglet_Piece_2 Juglet_Piece_3 Juglet_Piece_5 Juglet_Piece_7 Juglet_Piece_9 Pot_A_Piece_07"
ARMS="AO A A2 B C D"
: > "$OUT/cells.list"
for pc in $PIECES; do
  case "$pc" in
    Pot_A*) pot=Pot_A ;;
    *) pot=Juglet ;;
  esac
  for ar in $ARMS; do echo "$ar $pot $pc" >> "$OUT/cells.list"; done
done
echo "[JOB] cells: $(wc -l < "$OUT/cells.list")"
{
  echo "# ticket 33 cell commands, one per cell: the exact env the binary ran with"
  echo "# tag pot piece | switches"
  while read -r t pt pc; do
    case "$t" in
      AO) e="(none) -- ORIG binary $ORIG" ;;
      A)  e="(none) -- NEW binary" ;;
      A2) e="(none) -- NEW binary, repeat" ;;
      B)  e="SFS_NORMAL_SOURCE=input" ;;
      C)  e="SFS_NORMAL_SOURCE=input SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200 SFS_COUNT_SCALE=auto SFS_FLOOR_CEILING=<0.02|0.015|0.01|0.0075|0.005, first that lands the floor at <=2%>" ;;
      D)  e="SFS_NORMAL_SOURCE=input SFS_MERGE_MIN_PAIRS=2 SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200 SFS_COUNT_SCALE=auto SFS_FLOOR_CEILING=<same ladder>" ;;
    esac
    echo "$t|$pt|$pc	TAB	cd <stage> && $APT exec --bind /data:/data $SIF env POT_NAME=$pt SFS_AXIS_FILE=<stage>/Dataset/Axes/$pc"'_Axis.xyz'" SFS_DUMP_STAGE=<cell>/dump $e <BIN-of-the-arm>"
  done < "$OUT/cells.list"
} > "$OUT/commands.txt"

date -u +"cells start %Y-%m-%dT%H:%M:%SZ"
xargs -a "$OUT/cells.list" -d "\n" -n 1 -P "$P" bash -c 'run_cell_one "$1"' _ >> logs/cells.log 2>&1
RC_X=$?
echo "[JOB] xargs rc=$RC_X; cell.tsv written: $(ls "$ECELLS"/*/*/*/cell.tsv 2>/dev/null | wc -l) of $(wc -l < "$OUT/cells.list")"
grep -h '^\[CELL\]' logs/cells.log 2>/dev/null || true
date -u +"cells end %Y-%m-%dT%H:%M:%SZ"

printf "tag\tpot\tpiece\tenvs\tfrac\tmesh_exit\tmeas_exit\telapsed_s\tnpts\tretries\tclusters_pre_merge\tclusters_post_merge\tsizes_post_merge\toutcome\tfloor\tfloor_from\tcapped\tsurf0\tsurf1\tsurf0_points\tsurf1_points\tsurf0_bytes\tkept\n" > "$OUT/cells33.tsv"
for f in "$ECELLS"/*/*/*/cell.tsv; do
  [ -f "$f" ] && cat "$f" >> "$OUT/cells33.tsv"
done
echo "[JOB] cells33.tsv rows=$($(wc -l < "$OUT/cells33.tsv") - 1)"

echo "[JOB] aggregate measurement tables"
"$PY" "$INSTR/measure33.py" agg --cellroot "$ECELLS" --out "$OUT" 2>&1 | tee logs/agg.log
echo "[JOB] defaults proof: AO (pre-change binary) against A (this commit, no switches)"
"$PY" "$INSTR/measure33.py" defaults --orig "$ECELLS/AO" --new "$ECELLS/A" \
    --out "$OUT/defaults33.tsv" 2>&1 | tee logs/defaults.log

for t in cells33.tsv surfaces33.tsv pairs33.tsv carried33.tsv replay33.tsv defaults33.tsv; do
  if [ -f "$OUT/$t" ]; then echo "[JOB] $t rows=$(wc -l < "$OUT/$t")"; else echo "[JOB] $t MISSING"; fi
done
{
  echo "== cells33.tsv"
  cat "$OUT/cells33.tsv"
  echo "== surfaces33.tsv"
  cat "$OUT/surfaces33.tsv"
  echo "== carried33.tsv"
  cat "$OUT/carried33.tsv"
  echo "== defaults33.tsv"
  cat "$OUT/defaults33.tsv"
} 2>&1 | head -120

{
  echo "# ticket 33 -- geometry written by this run, recorded BEFORE the delete."
  echo "# The two binaries stay at out/bin-orig and out/bin-new; everything below is reproducible"
  echo "# from the two commits and the corpus by out/commands.txt."
  echo -e "key\text\tfiles\tbytes"
  "$PY" - "$RUN" <<'PYEOF'
import os, sys
from collections import defaultdict
run = sys.argv[1]
rows = []
for root, _d, fs in os.walk(os.path.join(run, "build")):
    for f in fs:
        p = os.path.join(root, f)
        try:
            n = os.path.getsize(p)
        except OSError:
            continue
        rows.append((os.path.relpath(p, run), os.path.splitext(f)[1].lower(), n))
rows.sort()
c = defaultdict(int)
b = defaultdict(int)
for rel, ext, n in rows:
    c[ext or "none"] += 1
    b[ext or "none"] += n
for ext in sorted(c):
    print("ext\t%s\t%d\t%d" % (ext, c[ext], b[ext]))
print("#")
print("total\tall\t%d\t%d" % (len(rows), sum(b.values())))
if len(rows) <= 4000:
    for rel, ext, n in rows:
        print("file\t%s\t%s\t%d" % (rel, ext or "none", n))
else:
    print("# per-file list omitted: %d files, the per-extension totals above are complete" % len(rows))
PYEOF
  echo "#"
  echo "# KEPT: out/cells33.tsv, out/surfaces33.tsv, out/pairs33.tsv, out/carried33.tsv,"
  echo "# out/replay33.tsv, out/defaults33.tsv, out/bin-orig, out/bin-new, out/commands.txt,"
  echo "# out/cells.list, out/inputs_before.md5, out/inputs_after.md5, out/corpus_before.txt,"
  echo "# out/corpus_after.txt, out/pristine.txt, out/cells/<tag>/<pot>/<piece>/{cell.tsv,logs/,"
  echo "# surfaces/,measure/}, logs/"
} > "$OUT/GEOMETRY_DELETED.txt" 2>&1
head -8 "$OUT/GEOMETRY_DELETED.txt"
B_BYTES=$(du -sb "$RUN/build" 2>/dev/null | cut -f1)
B_FILES=$(find "$RUN/build" -type f 2>/dev/null | wc -l)
rm -rf "$RUN/build"
{
  echo "#"
  echo "# deleted at $(date -u +%Y-%m-%dT%H:%M:%SZ): $B_FILES files, $B_BYTES bytes (the two build trees)"
  echo "# after the delete: $(find "$RUN/build" -type f 2>/dev/null | wc -l) files remain, build/ is $([ -d "$RUN/build" ] && echo present || echo gone)"
  echo "# per-cell stage and rung-dump counts: out/cells/<tag>/<pot>/<piece>/logs/geometry_counts.tsv"
} >> "$OUT/GEOMETRY_DELETED.txt"
echo "[JOB] build trees deleted: $B_FILES files, $B_BYTES bytes"
{
  echo "# cells whose stage and rung dump were NOT deleted because the measurement failed"
  found=0
  for d in "$ECELLS"/*/*/*/cell.tsv; do
    [ -f "$d" ] || continue
    k=$(cut -f23 "$d")
    if [ "$k" = "yes" ]; then echo "$d"; found=$((found + 1)); fi
  done
  echo "# count $found"
} > "$OUT/GEOMETRY_KEPT.txt" 2>&1
tail -4 "$OUT/GEOMETRY_KEPT.txt"

hash_inputs "$OUT/inputs_after.md5"
corpus_tree "$OUT/corpus_after.txt"
if diff -q "$OUT/inputs_before.md5" "$OUT/inputs_after.md5" > "$OUT/inputs.diff" 2>&1; then
  echo "[INPUTS] identical before and after: $(wc -l < "$OUT/inputs_before.md5") rows"
else
  echo "[INPUTS] DIFFERS"; cat "$OUT/inputs.diff"
fi
if diff -q "$OUT/corpus_before.txt" "$OUT/corpus_after.txt" > "$OUT/corpus.diff" 2>&1; then
  echo "[CORPUS] identical before and after: $(wc -l < "$OUT/corpus_before.txt") rows incl the pristine line"
else
  echo "[CORPUS] DIFFERS"; cat "$OUT/corpus.diff"
fi
grep -m1 "opt-sfs-pristine" "$OUT/corpus_after.txt" || true

printf "%s\t%s\t%s\t%s\t\t\n" "$RUNID" "$JOBID" "$NEW" "$IXTAG" >> "$IDX"
echo "[JOB] index row appended:"
tail -1 "$IDX" | cat -A | head -1
date -u +"end %Y-%m-%dT%H:%M:%SZ"
echo "[JOB] DONE rc 0"
