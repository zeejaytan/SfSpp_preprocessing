#!/bin/bash
#SBATCH --job-name=__JOBNAME__
#SBATCH --account=punim2657
#SBATCH --partition=sapphire
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=__TIME__
#SBATCH --output=__RUNDIR__/logs/slurm-%j.out
#SBATCH --error=__RUNDIR__/logs/slurm-%j.err
# ticket 32, PART E -- the pipeline's own answer. This one does build and run the binary: the
# question (does the pipeline report the same fragmentation, and what survives a lower floor)
# cannot be asked of a python replica. The build is the project's own cmake target inside the
# project's own SIF, extracted from the canonical checkout by commit; nothing is edited.
#
# Arms: the lead's exact switch set (SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200
# SFS_COUNT_SCALE=auto SFS_FLOOR_CEILING=<frac>), written here as "plain", and the same set
# plus SFS_SINGLE_CLUSTER=write, written here as "single" -- ticket 23 measured that a surface
# is only written from a lone cluster with that switch, so without it the coverage and extent
# columns would be empty by construction. Both arms are reported separately.
set -uo pipefail

RUN=__RUNDIR__
RUNID=__RUNID__
NEW=__NEWCOMMIT__
IXTAG=__IXTAG__
CANON=/data/gpfs/projects/punim2657/sfs_preprocessing
CORP=/data/gpfs/projects/punim2657/sfs_main/original_samples/SfS_pp
BOOT=/data/gpfs/projects/punim2657/SfSpp/runs/20261027-0055_d8af9d2_p07-juglet-stage1/out/boot
SIF=$CANON/pcl_191_nurbs.sif
APT=/apps/easybuild-2022/easybuild/software/Compiler/GCCcore/11.3.0/Apptainer/1.3.3/bin/apptainer
PY=/data/gpfs/projects/punim2657/TORA/envs/tora/bin/python3
INSTR=$RUN/instruments
CELLROOT=$RUN/out/cells
OUT=$RUN/out
RUNS=/data/gpfs/projects/punim2657/SfSpp/runs
IDX=$RUNS/index.tsv
JOBID=${SLURM_JOB_ID:-na}
P=${SLURM_CPUS_PER_TASK:-8}
PIECES="Juglet_Piece_2 Juglet_Piece_3 Juglet_Piece_9"
TAGS="F003 F002 F001 F003S F002S F001S"
export RUN RUNID NEW IXTAG CANON CORP BOOT SIF APT PY INSTR CELLROOT OUT RUNS IDX JOBID P SLURM_CPUS_PER_TASK

cd "$RUN" || exit 1
mkdir -p logs "$OUT" "$CELLROOT" build

fail() {
  local rc=$1; shift
  {
    echo "runid=$RUNID"
    echo "jobid=$JOBID"
    echo "commit=$NEW"
    echo "tag=$IXTAG"
    echo "rc=$rc"
    echo "reason: $*"
    date -u +"at %Y-%m-%dT%H:%M:%SZ"
  } > "$OUT/RUN-FAILED.txt"
  echo "[JOB] FATAL rc=$rc $* (see out/RUN-FAILED.txt)"
  exit "$rc"
}

echo "[JOB] runid=$RUNID job=$JOBID tag=$IXTAG commit=$NEW host=$(hostname)"
date -u +"start %Y-%m-%dT%H:%M:%SZ"

git -C "$CANON" fetch --no-tags origin "+refs/heads/*:refs/remotes/origin/*" >> logs/fetch.log 2>&1
if ! git -C "$CANON" cat-file -e "${NEW}^{commit}" 2>>logs/fetch.log; then
  fail 2 "commit $NEW not in $CANON"
fi
echo "[JOB] commit ok new=$(git -C "$CANON" rev-parse --short "$NEW")"

hash_inputs() {
  local out=$1 f
  {
    for f in "$CANON"/Dataset/Point/Juglet/*.pcd "$CANON"/Dataset/Mesh/Juglet/*.obj              "$BOOT"/*_boot_Axis.xyz; do
      if [ -f "$f" ]; then
        printf "%s\t%s\t%s\n" "$(md5sum "$f" | cut -d" " -f1)" "$(stat -c %s "$f")" "$f"
      else
        printf "MISSING\t0\t%s\n" "$f"
      fi
    done
    printf "%s\t%s\t%s\n" "$(md5sum "$SIF" | cut -d" " -f1)" "$(stat -c %s "$SIF")" "$SIF"
  } | sort -k3 > "$out"
}

corpus_tree() {
  local out=$1
  {
    find "$CORP" -type f -printf "%p\t%s\t%T@\n" | sort
    find "$CANON/Dataset" -type f -printf "%p\t%s\t%T@\n" | sort
    if [ -d /opt/sfs-pristine ]; then
      echo "opt-sfs-pristine PRESENT $(ls -R /opt/sfs-pristine | md5sum | cut -d' ' -f1)"
    else
      echo "opt-sfs-pristine ABSENT"
    fi
  } > "$out"
}

pristine_record() {
  local out=$1
  {
    echo "# /opt/sfs-pristine, recorded from the compute node"
    if [ -d /opt/sfs-pristine ]; then
      echo "status PRESENT"
      ls -la /opt/sfs-pristine
    else
      echo "status ABSENT"
      ls -d /opt/sfs-pristine 2>&1 || true
      stat /opt/sfs-pristine 2>&1 || true
    fi
  } > "$out"
}

build_arm() {
  local name=$1 sha=$2 rc
  echo "[BUILD] $name from $sha"
  mkdir -p "build/$name/src/build"
  git -C "$CANON" archive "$sha" | tar -x -C "build/$name/src" || { echo "[BUILD] archive FAILED $sha"; return 1; }
  ( cd "build/$name/src/build" \
    && "$APT" exec --bind /data:/data "$SIF" cmake -DCMAKE_BUILD_TYPE=Release .. \
    && "$APT" exec --bind /data:/data "$SIF" make -j"$P" MeshPreprocessingHeadless \
  ) > "logs/build-$name.log" 2>&1
  rc=$?
  if [ $rc -eq 0 ] && [ -x "build/$name/src/build/MeshPreprocessingHeadless" ]; then
    cp -f "build/$name/src/build/MeshPreprocessingHeadless" "out/bin-$name"
    echo "[BUILD] $name ok $(stat -c %s "out/bin-$name") bytes"
    return 0
  fi
  echo "[BUILD] $name FAILED rc=$rc -- tail of logs/build-$name.log:"
  tail -25 "logs/build-$name.log"
  return 1
}

arms_env() {
  case "$1" in
    F003) echo "SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200 SFS_COUNT_SCALE=auto SFS_FLOOR_CEILING=0.03" ;;
    F002) echo "SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200 SFS_COUNT_SCALE=auto SFS_FLOOR_CEILING=0.02" ;;
    F001) echo "SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200 SFS_COUNT_SCALE=auto SFS_FLOOR_CEILING=0.01" ;;
    F003S) echo "SFS_SINGLE_CLUSTER=write SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200 SFS_COUNT_SCALE=auto SFS_FLOOR_CEILING=0.03" ;;
    F002S) echo "SFS_SINGLE_CLUSTER=write SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200 SFS_COUNT_SCALE=auto SFS_FLOOR_CEILING=0.02" ;;
    F001S) echo "SFS_SINGLE_CLUSTER=write SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200 SFS_COUNT_SCALE=auto SFS_FLOOR_CEILING=0.01" ;;
    *) echo "" ;;
  esac
}

run_one() {
  local tag=$1 piece=$2
  POT=Juglet
  PIECE=$piece
  TAG=$tag
  ENVS=$(arms_env "$tag")
  AXIS=$BOOT/${piece}_boot_Axis.xyz
  BIN=$RUN/build/new/src/build/MeshPreprocessingHeadless
  STAGER=$INSTR/stage_piece_p23.sh
  COMMIT=$NEW
  export POT PIECE TAG ENVS AXIS BIN STAGER COMMIT
  bash "$INSTR/run_cell23.sh" "$tag"
}
export -f run_one arms_env

hash_inputs "$OUT/inputs_before.md5"
corpus_tree "$OUT/corpus_before.txt"
pristine_record "$OUT/pristine.txt"
echo "[JOB] inputs hashed: $(wc -l < "$OUT/inputs_before.md5") rows, tree $(wc -l < "$OUT/corpus_before.txt") rows"
grep -m1 "opt-sfs-pristine" "$OUT/corpus_before.txt" || true
cat "$OUT/pristine.txt"

echo "[JOB] build the pipeline from $NEW inside $SIF"
build_arm new "$NEW" || fail 3 "the pipeline did not build (logs/build-new.log)"
"out/bin-new" --help > logs/binary-help.log 2>&1 || true

printf "tag\tpot\tpiece\tenvs\tmesh_exit\telapsed_s\tnpts\tretries\tclusters\tsizes\toutcome\tfloor\tfloor_from\tcapped\tsurf0\tsurf1\tsurf0_points\tsurf1_points\tswitch\tfloor_line\tsingle\tstatus\tspacing\tcount\twarn_missing\tsurf0_bytes\n" > "$CELLROOT/cells23.tsv"
printf "cell\text\tcount\tbytes\n" > "$CELLROOT/geometry_counts.tsv"
: > out/cells.list
for p in $PIECES; do for t in $TAGS; do echo "$t $p" >> out/cells.list; done; done
echo "[JOB] cells to run: $(wc -l < out/cells.list)"
{
  echo "# ticket 32 part E, exact pipeline command per cell"
  echo "# arm plain = SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200 SFS_COUNT_SCALE=auto SFS_FLOOR_CEILING=<frac>"
  echo "# arm single = the same plus SFS_SINGLE_CLUSTER=write"
  while read -r t p; do
    echo -e "$t\t$p\tcd <stage> && $APT exec --bind /data:/data $SIF env POT_NAME=Juglet SFS_AXIS_FILE=<stage>/Dataset/Axes/$p"'_Axis.xyz'" SFS_STATUS_FILE=<cell>/status_raw.tsv $(arms_env "$t") $RUN/build/new/src/build/MeshPreprocessingHeadless"
  done < out/cells.list
} > out/commands.txt

date -u +"cells start %Y-%m-%dT%H:%M:%SZ"
xargs -a out/cells.list -d "\n" -n 2 -P "$P" bash -c 'run_one "$@"' _ >> logs/cells.log 2>&1
RC_CELLS=$?
echo "[JOB] cells xargs rc=$RC_CELLS"
echo "[JOB] cells that wrote a cell.tsv: $(ls "$CELLROOT"/*/*/*/cell.tsv 2>/dev/null | wc -l) of $(wc -l < out/cells.list)"
grep -h '^\[CELL\]' logs/cells.log 2>/dev/null || true
echo "[JOB] cells23.tsv rows: $(( $(wc -l < "$CELLROOT/cells23.tsv") - 1 ))"

echo "[JOB] coverage of any written surface"
"$PY" "$INSTR/coverage23.py" "$CELLROOT" > logs/coverage.log 2>&1
COV_RC=$?
echo "[JOB] coverage23.py rc=$COV_RC"; tail -6 logs/coverage.log 2>/dev/null || true

echo "[JOB] part E table"
"$PY" "$INSTR/partE32.py" --cells "$CELLROOT" --dataset "$CANON/Dataset" --out "$OUT/partE32.tsv" \
  > logs/parte.log 2>&1
E_RC=$?
echo "[JOB] partE32.py rc=$E_RC"; cat logs/parte.log 2>/dev/null || true
[ "$E_RC" -eq 0 ] || fail 6 "partE32.py rc=$E_RC (logs/parte.log)"
[ -s "$OUT/partE32.tsv" ] || fail 6 "out/partE32.tsv missing or empty"

echo "[JOB] part E table, first rows"
head -4 "$OUT/partE32.tsv"

{
  echo "# ticket 32 part E -- geometry written by this run, recorded BEFORE the delete."
  echo "# Everything here is reproducible from the corpus and the commit by out/commands.txt."
  echo -e "key\text\tfiles\tbytes"
  "$PY" - "$RUN" "$CELLROOT" <<'PYEOF'
import os, sys
from collections import defaultdict
run, cellroot = sys.argv[1], sys.argv[2]
rows = []
for base in (os.path.join(run, "build"), cellroot):
    for root, _d, fs in os.walk(base):
        for f in fs:
            p = os.path.join(root, f)
            try:
                n = os.path.getsize(p)
            except OSError:
                continue
            rel = os.path.relpath(p, run)
            if rel.split(os.sep)[0] == "build" or os.sep + "stage" + os.sep in rel:
                rows.append((rel, os.path.splitext(f)[1].lower(), n))
rows.sort()
c = defaultdict(int)
b = defaultdict(int)
for rel, ext, n in rows:
    c[ext or "none"] += 1
    b[ext or "none"] += n
for ext in sorted(c):
    print("ext\t%s\t%d\t%d" % (ext, c[ext], b[ext]))
print("#")
print("total\tall\t%d\t%d" % (len(rows), sum(b.values())))
if len(rows) <= 4000:
    for rel, ext, n in rows:
        print("file\t%s\t%s\t%d" % (rel, ext or "none", n))
else:
    print("# per-file list omitted: %d files, the per-extension totals above are complete" % len(rows))
PYEOF
  echo "#"
  echo "# KEPT: out/partE32.tsv, out/cells/cells23.tsv, out/cells/geometry_counts.tsv,"
  echo "# out/cells/coverage23.tsv, out/cells/<tag>/Juglet/<piece>/cell.tsv and logs/"
  echo "# (mesh.log, lines23.log, stage.log, status_raw.tsv) and surfaces/ (the small PLY),"
  echo "# out/commands.txt, out/cells.list, out/bin-new, out/inputs_*.md5, out/corpus_*.txt,"
  echo "# out/pristine.txt, logs/ (slurm out/err, build-new.log, cells.log, coverage.log, parte.log)"
} > "$OUT/GEOMETRY_DELETED.txt" 2>&1
head -14 "$OUT/GEOMETRY_DELETED.txt"
BEFORE_BYTES=$(du -sb "$RUN/build" 2>/dev/null | cut -f1)
BEFORE_FILES=$(find "$RUN/build" -type f 2>/dev/null | wc -l)
rm -rf "$RUN/build"
find "$CELLROOT" -type d -name stage -prune -exec rm -rf {} + 2>/dev/null || true
AFTER_FILES=$(find "$RUN/build" -type f 2>/dev/null | wc -l)
if [ -d "$RUN/build" ]; then AFTER_DIR=present; else AFTER_DIR=gone; fi
{
  echo "#"
  echo "# deleted at $(date -u +%Y-%m-%dT%H:%M:%SZ): $BEFORE_FILES files, $BEFORE_BYTES bytes (the build tree; stage dirs are deleted per cell and counted in geometry_counts.tsv)"
  echo "# after the delete: $AFTER_FILES files remain, build/ is $AFTER_DIR"
} >> "$OUT/GEOMETRY_DELETED.txt"
tail -4 "$OUT/GEOMETRY_DELETED.txt"
echo "[JOB] geometry deleted: $BEFORE_FILES files, $BEFORE_BYTES bytes"
echo "[JOB] run dir bytes: $(du -sb "$RUN" | awk '{print $1}')"

hash_inputs "$OUT/inputs_after.md5"
corpus_tree "$OUT/corpus_after.txt"
if diff -q "$OUT/inputs_before.md5" "$OUT/inputs_after.md5" > "$OUT/inputs.diff" 2>&1; then
  echo "[INPUTS] identical before and after: $(wc -l < "$OUT/inputs_before.md5") rows"
else
  echo "[INPUTS] DIFFERS"; cat "$OUT/inputs.diff"
fi
if diff -q "$OUT/corpus_before.txt" "$OUT/corpus_after.txt" > "$OUT/corpus.diff" 2>&1; then
  echo "[CORPUS] identical before and after: $(wc -l < "$OUT/corpus_before.txt") rows incl the pristine line"
else
  echo "[CORPUS] DIFFERS"; cat "$OUT/corpus.diff"
fi
grep -m1 "opt-sfs-pristine" "$OUT/corpus_after.txt" || true

printf "%s\t%s\t%s\t%s\t\t\n" "$RUNID" "$JOBID" "$NEW" "$IXTAG" >> "$IDX"
echo "[INDEX] appended:"
tail -1 "$IDX" | cat -A
echo "[JOB] done"
