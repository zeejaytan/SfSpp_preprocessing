#!/usr/bin/env bash
#SBATCH --account=punim2657
#SBATCH --partition=sapphire
#SBATCH --job-name=__JOBNAME__
#SBATCH --time=__TIME__
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --output=logs/slurm-%j.out
#
# ticket 22, arm grid. One run directory per job; one cell per (arm, piece) under out/cells/.
# Builds the new commit and the pre-change commit (main) from the canonical checkout's object
# store, runs every arm x piece, measures the surface pairs, proves the inputs unchanged.
# Nothing is scored here and no arm is chosen: cells.tsv and measure.tsv are the record.
set -uo pipefail
RUN=__RUNDIR__
NEW=__NEWCOMMIT__
OLD=__OLDCOMMIT__
POT=__POT__
PIECES="__PIECES__"
CANON=/data/gpfs/projects/punim2657/sfs_preprocessing
CORP=/data/gpfs/projects/punim2657/sfs_main/original_samples/SfS_pp
BOOT=/data/gpfs/projects/punim2657/SfSpp/runs/20261027-0055_d8af9d2_p07-juglet-stage1/out/boot
SIF=$CANON/pcl_191_nurbs.sif
APT=/apps/easybuild-2022/easybuild/software/Compiler/GCCcore/11.3.0/Apptainer/1.3.3/bin/apptainer
PY=/data/gpfs/projects/punim2657/TORA/envs/tora/bin/python3
INSTR=$RUN/instruments
CELLROOT=$RUN/out/cells
RUNID=$(basename "$RUN")
TAGS="__TAGS__"
export RUN NEW OLD POT CANON CORP BOOT SIF APT INSTR CELLROOT RUNID

cd "$RUN" || exit 1
mkdir -p logs out/cells build out/bin
say() { echo "[$(date +%H:%M:%S)] $*"; }

axis_of() {
  case "$1" in
    Juglet_Piece_*) echo "$BOOT/$1_boot_Axis.xyz" ;;
    *) echo "$CANON/Dataset/Axes/$POT/$1_Axis.xyz" ;;
  esac
}

hash_inputs() {
  local p f
  for p in $PIECES; do
    if [ "$POT" = "Pot_A" ]; then
      f="$CORP/Point/Pot_A/${p}_Point.pcd"; [ -f "$f" ] && md5sum "$f"
      f="$CORP/Mesh/Pot_A/${p}_Mesh.obj"; [ -f "$f" ] && md5sum "$f"
    else
      f="$CANON/Dataset/Point/$POT/${p}_Point.pcd"; [ -f "$f" ] && md5sum "$f"
      f="$CANON/Dataset/Mesh/$POT/${p}_Mesh.obj"; [ -f "$f" ] && md5sum "$f"
    fi
    f=$(axis_of "$p"); [ -f "$f" ] && md5sum "$f"
  done | sort -k2
}

build_arm() {
  local name=$1 sha=$2 rc
  say "build $name from $sha"
  mkdir -p "build/$name/src/build"
  git -C "$CANON" archive "$sha" | tar -x -C "build/$name/src" || { say "archive FAILED $sha"; return 1; }
  ( cd "build/$name/src/build" \
    && "$APT" exec --bind /data:/data "$SIF" cmake -DCMAKE_BUILD_TYPE=Release .. \
    && "$APT" exec --bind /data:/data "$SIF" make -j"${SLURM_CPUS_PER_TASK:-8}" MeshPreprocessingHeadless \
  ) > "logs/build-$name.log" 2>&1
  rc=$?
  if [ $rc -eq 0 ] && [ -x "build/$name/src/build/MeshPreprocessingHeadless" ]; then
    cp -f "build/$name/src/build/MeshPreprocessingHeadless" "out/bin/MeshPreprocessingHeadless.$name"
    say "build $name ok"
    return 0
  fi
  say "build $name FAILED rc=$rc -- tail of logs/build-$name.log:"
  tail -12 "logs/build-$name.log"
  return 1
}

arms_env() {
  case "$1" in
    A|A_old|A_new2) echo "" ;;
    B) echo "SFS_REASSIGN_MODE=own" ;;
    C100) echo "SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=100 SFS_COUNT_SCALE=auto" ;;
    C200) echo "SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200 SFS_COUNT_SCALE=auto" ;;
    C400) echo "SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=400 SFS_COUNT_SCALE=auto" ;;
    C2_100) echo "SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=100" ;;
    C2_200) echo "SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200" ;;
    C2_400) echo "SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=400" ;;
    D100) echo "SFS_REASSIGN_MODE=own SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=100 SFS_COUNT_SCALE=auto" ;;
    D200) echo "SFS_REASSIGN_MODE=own SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=200 SFS_COUNT_SCALE=auto" ;;
    D400) echo "SFS_REASSIGN_MODE=own SFS_SPACING_POLICY=piece SFS_SPACING_SAMPLES=400 SFS_COUNT_SCALE=auto" ;;
    *) echo "" ;;
  esac
}

arm_bin() {
  case "$1" in
    A_old) echo old ;;
    *) echo new ;;
  esac
}

run_one() {
  local tag=$1 piece=$2 bk
  bk=$(arm_bin "$tag")
  PIECE=$piece
  TAG=$tag
  ENVS=$(arms_env "$tag")
  AXIS=$(axis_of "$piece")
  BIN=$RUN/build/$bk/src/build/MeshPreprocessingHeadless
  STAGER=$INSTR/stage_piece_p20.sh
  if [ "$bk" = "old" ]; then COMMIT=$OLD; else COMMIT=$NEW; fi
  export PIECE TAG ENVS AXIS BIN STAGER COMMIT
  bash "$INSTR/run_cell.sh" "$tag"
}

say "job ${SLURM_JOB_ID:-local} run=$RUNID pot=$POT pieces=${PIECES} arms=${TAGS}"
hash_inputs > out/inputs_before.md5
say "inputs hashed: $(wc -l < out/inputs_before.md5) files -> out/inputs_before.md5"

build_arm new "$NEW" || exit 2
build_arm old "$OLD" || exit 2

printf "tag\tpot\tpiece\tenvs\tmesh_exit\telapsed_s\tclusters_pre\tclusters_post\tsizes_pre\tgrow\tmerge\tclassify\tface\tspacing\tcount\tcount_merge\treassign\tsurf0\tsurf1\tsurf0_md5\tsurf1_md5\tsurf0_bytes\tsurf1_bytes\tseg_points\tseg_md5\n" > out/cells/cells.tsv
printf "cell\text\tcount\tbytes\n" > out/cells/geometry_counts.tsv
: > out/cells.list
for p in $PIECES; do for t in $TAGS; do echo "$t $p" >> out/cells.list; done; done
say "cells to run: $(wc -l < out/cells.list)"

export -f axis_of arms_env arm_bin run_one
xargs -a out/cells.list -n 2 -P "${SLURM_CPUS_PER_TASK:-8}" bash -c 'run_one "$@"' _ 2>&1 | tee out/run_cells.log | grep -c '^\[CELL\]' | xargs -I{} echo "[$(date +%H:%M:%S)] cells reported: {}"

say "measuring surface pairs"
"$PY" "$INSTR/measure_arm.py" "$CELLROOT" > out/measure.log 2>&1
say "measure exit=$? -> $(tail -1 out/measure.log)"

hash_inputs > out/inputs_after.md5
if diff -q out/inputs_before.md5 out/inputs_after.md5 > /dev/null; then
  say "[CHECK] inputs unchanged: $(wc -l < out/inputs_after.md5) files identical before/after"
else
  say "[CHECK] INPUTS CHANGED -- see out/inputs_before.md5 out/inputs_after.md5"
  diff out/inputs_before.md5 out/inputs_after.md5 | head -20
fi

say "geometry deleted: $(awk -F'\t' 'NR>1{c+=$3; b+=$4} END{printf "%d files, %d bytes", c, b}' out/cells/geometry_counts.tsv)"
say "run dir bytes: $(du -sb "$RUN" | awk '{print $1}')"
rm -rf build
printf "%s\t%s\t%s\t%s\t\t\n" "$RUNID" "${SLURM_JOB_ID:-local}" "$NEW" "$POT-armgrid22" >> /data/gpfs/projects/punim2657/SfSpp/runs/index.tsv
say "done: out/cells/cells.tsv $(($(wc -l < out/cells/cells.tsv) - 1)) rows, out/cells/measure.tsv $(($(wc -l < out/cells/measure.tsv) - 1)) rows"
