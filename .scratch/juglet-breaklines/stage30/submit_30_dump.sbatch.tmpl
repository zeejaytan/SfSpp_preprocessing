#!/bin/bash
#SBATCH --job-name=__JOBNAME__
#SBATCH --account=punim2657
#SBATCH --partition=sapphire
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=__TIME__
#SBATCH --output=__RUNDIR__/logs/slurm-%j.out
#SBATCH --error=__RUNDIR__/logs/slurm-%j.err
# ticket 30 -- part A and part B: re-derive the nine clouds (Pot A 07 at the shipped defaults,
# the four Juglet clouds at the defaults and again with the paper chain off at native density),
# inside this ticket's own run directory, then measure curvature and neighbour angles on them.
# Nothing is borrowed from ticket 29's deleted dumps; every cloud below is written by this job.
set -uo pipefail

RUN=__RUNDIR__
RUNID=__RUNID__
NEW=__NEWCOMMIT__
IXTAG=__IXTAG__
CANON=/data/gpfs/projects/punim2657/sfs_preprocessing
CORP=/data/gpfs/projects/punim2657/sfs_main/original_samples/SfS_pp
BOOT=/data/gpfs/projects/punim2657/SfSpp/runs/20261027-0055_d8af9d2_p07-juglet-stage1/out/boot
SIF=$CANON/pcl_191_nurbs.sif
APT=/apps/easybuild-2022/easybuild/software/Compiler/GCCcore/11.3.0/Apptainer/1.3.3/bin/apptainer
INSTR=$RUN/instruments
CELLROOT=$RUN/out/cells
DUMPROOT=$RUN/out/dump
STAGER=$INSTR/stage_piece_p30.sh
LIST=$RUN/out/cells.list
PY=/data/gpfs/projects/punim2657/TORA/envs/tora/bin/python3
BIND="--bind /data:/data"
# tag:piece -- PA is the sample cloud, B the shipped Juglet chain, E the chain off at native
# density. Nine cells, which is the nine clouds the ticket's table names (its "twelve cells"
# figure is ticket 25/29's three-arm grid: B, D, E x four pieces; this ticket runs no D arm).
CLOUDS="PA:Pot_A_Piece_07 B:Juglet_Piece_2 B:Juglet_Piece_3 B:Juglet_Piece_5 B:Juglet_Piece_7 E:Juglet_Piece_2 E:Juglet_Piece_3 E:Juglet_Piece_5 E:Juglet_Piece_7"
export CANON CORP BOOT SIF APT INSTR CELLROOT DUMPROOT STAGER LIST PY NEW RUN RUNID SLURM_CPUS_PER_TASK

cd "$RUN" || exit 1
mkdir -p out/bin out/cells out/dump logs
echo "[JOB] runid=$RUNID job=$SLURM_JOB_ID new=$NEW clouds=$(echo $CLOUDS | wc -w) cpus=${SLURM_CPUS_PER_TASK:-?}"
date -u +"start %Y-%m-%dT%H:%M:%SZ"

git -C "$CANON" fetch --no-tags origin "+refs/heads/*:refs/remotes/origin/*" >> logs/fetch.log 2>&1
if ! git -C "$CANON" cat-file -e "${NEW}^{commit}" 2>>logs/fetch.log; then
  echo "[JOB] FATAL commit $NEW not in $CANON"; exit 2
fi
echo "[JOB] commit ok new=$(git -C "$CANON" rev-parse --short "$NEW")"

pot_of() { case "$1" in Juglet_Piece_*) echo Juglet ;; Pot_A_Piece_*) echo Pot_A ;; *) echo UNKNOWN ;; esac; }
cloud_of() { if [ "$(pot_of "$1")" = Pot_A ]; then echo "$CORP/Point/Pot_A/$1_Point.pcd"; else echo "$CANON/Dataset/Point/Juglet/$1_Point.pcd"; fi; }
mesh_of() { if [ "$(pot_of "$1")" = Pot_A ]; then echo "$CORP/Mesh/$1_Mesh.obj"; else echo "$CANON/Dataset/Mesh/Juglet/$1_Mesh.obj"; fi; }
axis_of() { if [ "$(pot_of "$1")" = Pot_A ]; then echo "$CANON/Dataset/Axes/Pot_A/$1_Axis.xyz"; else echo "$BOOT/$1_boot_Axis.xyz"; fi; }

hash_inputs() {
  local out=$1 spec tag piece f
  : > "$out"
  for spec in $CLOUDS; do
    tag=${spec%%:*}; piece=${spec##*:}
    for f in "$(cloud_of "$piece")" "$(mesh_of "$piece")" "$(axis_of "$piece")"; do
      if [ -f "$f" ]; then printf "%s\t%s\t%s\t%s\n" "$tag" "$piece" "$(md5sum "$f" | cut -d" " -f1)" "$f"
      else printf "%s\t%s\tMISSING\t%s\n" "$tag" "$piece" "$f"; fi
    done
  done | sort > "$out"
}

corpus_tree() {
  local out=$1
  { find "$CORP" -type f -printf "%p\t%s\t%T@\n" | sort
    if [ -d /opt/sfs-pristine ]; then ls -R /opt/sfs-pristine | md5sum
    else echo "opt-sfs-pristine ABSENT"; fi
  } > "$out"
}

build_new() {
  local dir=$RUN/build/new
  rm -rf "$dir"; mkdir -p "$dir/src"
  if ! git -C "$CANON" archive "$NEW" | tar -x -C "$dir/src"; then
    echo "[BUILD] FAILED archive"; return 1
  fi
  ( cd "$dir/src" && mkdir -p build && cd build \
      && "$APT" exec $BIND "$SIF" cmake -DCMAKE_BUILD_TYPE=Release .. \
      && "$APT" exec $BIND "$SIF" make -j"${SLURM_CPUS_PER_TASK:-8}" MeshPreprocessingHeadless ) >> logs/build-new.log 2>&1
  if [ ! -x "$dir/src/build/MeshPreprocessingHeadless" ]; then
    echo "[BUILD] FAILED make"; grep -E "error:|Error [0-9]" logs/build-new.log | head -40; return 1
  fi
  cp "$dir/src/build/MeshPreprocessingHeadless" out/bin/MeshPreprocessingHeadless.NEW
  echo "[BUILD] ok sha=$NEW bytes=$(stat -c %s out/bin/MeshPreprocessingHeadless.NEW) md5=$(md5sum out/bin/MeshPreprocessingHeadless.NEW | cut -d" " -f1)"
}

run_one() {
  local tag piece
  IFS=: read -r tag piece <<< "$1"
  [ -n "${tag:-}" ] || return 0
  POT=$(pot_of "$piece"); PIECE=$piece; TAG=$tag
  AXIS=$(axis_of "$piece"); BIN=$RUN/out/bin/MeshPreprocessingHeadless.NEW; COMMIT=$NEW
  export POT PIECE TAG AXIS BIN COMMIT
  bash "$INSTR/run_dump30.sh" "$tag"
}
export -f pot_of cloud_of mesh_of axis_of run_one

: > "$LIST"
: > "$RUN/out/meshpaths.tsv"
for spec in $CLOUDS; do
  tag=${spec%%:*}; piece=${spec##*:}
  printf "%s:%s\n" "$tag" "$piece" >> "$LIST"
  printf "%s\t%s\t%s\n" "$tag" "$piece" "$(mesh_of "$piece")" >> "$RUN/out/meshpaths.tsv"
done
echo "[JOB] cells in list: $(wc -l < "$LIST")"

hash_inputs out/inputs_before.md5
corpus_tree out/corpus_before.txt
echo "[JOB] inputs hashed: $(wc -l < out/inputs_before.md5) rows, corpus $(wc -l < out/corpus_before.txt) rows"

build_new || exit 3

printf "tag\tscheme\tpot\tpiece\tcommit\tstage_exit\tmesh_exit\telapsed_s\toutcome\tn0\tn1\tnpts\tunclustered_pts\tclusters\tsizes\tsurf0_points/surf1_points\n" > "$CELLROOT/cells30.tsv"
printf "tag\tpot\tpiece\tfile\tpoints\tbytes\n" > "$CELLROOT/dumpcounts30.tsv"
printf "key\text\tcount\tbytes\n" > "$CELLROOT/geometry_counts.tsv"
printf "# tag\tpot\tthen the 14 STATUS-23 fields: piece npts retries clusters sizes floor floor_from capped outcome p0_23 p1_23 single_cluster floor_ceiling reason\n" > "$CELLROOT/status30.tsv"
date -u +"cells start %Y-%m-%dT%H:%M:%SZ"
xargs -a "$LIST" -d "\n" -n 1 -P "${SLURM_CPUS_PER_TASK:-8}" bash -c 'run_one "$@"' _ >> logs/cells.log 2>&1
RC=$?
echo "[JOB] cells finished rc=$RC rows=$(($(wc -l < "$CELLROOT/cells30.tsv") - 1))"
grep "^\[CELL\]" logs/cells.log || true
date -u +"cells end %Y-%m-%dT%H:%M:%SZ"

echo "[JOB] cloud inventory (part A input; each rung file this job wrote)"
find "$DUMPROOT" -name "*.ply" | sort
echo "[JOB] per-cloud r1 point count and surfaces written"
awk -F"\t" 'NR>1 {printf "%-3s %-22s npts=%-8s outcome=%-5s surf0=%-8s surf1=%-8s unclustered=%s\n", $1, $4, $12, $9, $10, $11, $13}' "$CELLROOT/cells30.tsv"
echo "[JOB] rung counts per cloud (expect r1..r5 = 5 ply each)"
for spec in $CLOUDS; do
  tag=${spec%%:*}; piece=${spec##*:}
  printf "%s/%s files=%s\n" "$tag" "$piece" "$(find "$DUMPROOT/$tag/$piece" -name "*.ply" 2>/dev/null | wc -l)"
done

echo "[JOB] part A and part B (curvature radius, neighbour angles, the two rules)"
"$PY" "$INSTR/analyse30.py" "$RUN" 2>&1 | tee logs/analyse30.log
for f in tableA30.tsv rules30.tsv thetas30.json; do
  if [ -s "out/$f" ]; then echo "[JOB] wrote out/$f ($(wc -l < "out/$f") lines)"; else echo "[JOB] FATAL out/$f missing or empty"; fi
done
echo "[JOB] thetas"
cat out/thetas30.json || true

{
  echo "# ticket 30 dump job -- geometry deleted when each cell finished, with counts and bytes."
  echo "# KEPT: out/dump/** (the nine clouds, r1..r5 per cloud -- the part A input), every cell's"
  echo "# surfaces/*.ply and *.xyz, every log, and out/tableA30.tsv / rules30.tsv / thetas30.json."
  echo -e "key\text\tcount\tbytes"
  tail -n +2 "$CELLROOT/geometry_counts.tsv"
  echo "#"
  echo -e "ext\tfiles\tbytes"
  awk -F"\t" 'NR>1 {c[$2]+=$3; b[$2]+=$4} END {for (e in c) printf "%s\t%d\t%d\n", e, c[e], b[e]}' "$CELLROOT/geometry_counts.tsv" | sort
  echo "#"
  echo -e "total\t$(awk -F"\t" 'NR>1 {c+=$3; b+=$4} END {print c"\t"b}' "$CELLROOT/geometry_counts.tsv")"
  echo "# kept rung dumps: $(find "$DUMPROOT" -name "*.ply" | wc -l) ply, $(du -sb "$DUMPROOT" | cut -f1) bytes"
  echo "# kept surfaces: $(find "$CELLROOT" -path "*/surfaces/*" -name "*.ply" | wc -l) ply, $(find "$CELLROOT" -path "*/surfaces/*" -name "*.xyz" | wc -l) xyz"
  echo "# stage trees left on disk (expect 0): $(find "$CELLROOT" -maxdepth 3 -type d -name stage | wc -l)"
  echo "# geometry outside surfaces/ still present (expect 0):"
  find "$CELLROOT" -path "*/surfaces/*" -prune -o -type f \( -name "*.pcd" -o -name "*.obj" -o -name "*.xyz" \) -print | wc -l
} > out/GEOMETRY_DELETED.txt 2>&1
head -20 out/GEOMETRY_DELETED.txt

hash_inputs out/inputs_after.md5
corpus_tree out/corpus_after.txt
if diff -q out/inputs_before.md5 out/inputs_after.md5 > out/inputs.diff 2>&1; then
  echo "[INPUTS] identical before and after: $(wc -l < out/inputs_before.md5) rows"
else
  echo "[INPUTS] DIFFERS"; cat out/inputs.diff
fi
if diff -q out/corpus_before.txt out/corpus_after.txt > out/corpus.diff 2>&1; then
  echo "[CORPUS] identical before and after: $(wc -l < out/corpus_before.txt) rows (incl /opt/sfs-pristine line)"
else
  echo "[CORPUS] DIFFERS"; cat out/corpus.diff
fi
grep -m1 "opt-sfs-pristine" out/corpus_before.txt || true

printf "%s\t%s\t%s\t%s\t\t\n" "$RUNID" "$SLURM_JOB_ID" "$NEW" "$IXTAG" >> /data/gpfs/projects/punim2657/SfSpp/runs/index.tsv
echo "[INDEX] appended: $RUNID\t$SLURM_JOB_ID\t$NEW\t$IXTAG with empty verdict and human_note"
tail -2 /data/gpfs/projects/punim2657/SfSpp/runs/index.tsv

rm -rf "$RUN/build"
date -u +"end %Y-%m-%dT%H:%M:%SZ"
echo "[JOB] done run=$RUNID"
