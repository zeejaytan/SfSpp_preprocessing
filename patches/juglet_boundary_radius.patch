+	// Juglet fix (2026-09): this cloud is in MILLIMETRES, so the radius must
+	// be too. sqrt(1/N) assumed points over 1 m^2 (pinning r at the 15 mm
+	// clamp); worse, 0.015 then reads as 0.015 mm, below the point spacing,
+	// so no neighbour is ever found: empty boundary -> "writeASCII: no data"
+	// abort (Juglet_Piece_1 and _2). Spacing from the bbox sheet area; keep
+	// the evident intent (6x spacing, [1,15] clamp). Also changes Pot_A.
+	double estimated_spacing_mm = 100.0;
+	if (num_pts > 0)
+	{
+		double ex_min = cloudWithoutNormals->points[0].x, ex_max = ex_min;
+		double ey_min = cloudWithoutNormals->points[0].y, ey_max = ey_min;
+		double ez_min = cloudWithoutNormals->points[0].z, ez_max = ez_min;
+		for (size_t bi = 1; bi < cloudWithoutNormals->points.size(); bi++)
+		{
+			const PointXYZ& bp = cloudWithoutNormals->points[bi];
+			if (bp.x < ex_min) ex_min = bp.x; if (bp.x > ex_max) ex_max = bp.x;
+			if (bp.y < ey_min) ey_min = bp.y; if (bp.y > ey_max) ey_max = bp.y;
+			if (bp.z < ez_min) ez_min = bp.z; if (bp.z > ez_max) ez_max = bp.z;
+		}
+		double be0 = ex_max - ex_min, be1 = ey_max - ey_min, be2 = ez_max - ez_min;
+		// Two largest extents approximate the sheet area (sherds are thin).
+		double bsorted0 = be0, bsorted1 = be1;
+		if (bsorted1 > bsorted0) { double bt = bsorted0; bsorted0 = bsorted1; bsorted1 = bt; }
+		if (be2 > bsorted0) { bsorted1 = bsorted0; bsorted0 = be2; }
+		else if (be2 > bsorted1) { bsorted1 = be2; }
+		if (bsorted0 > 0 && bsorted1 > 0)
+			estimated_spacing_mm = std::sqrt((bsorted0 * bsorted1) / std::max(100, num_pts));
+	}
+	double boundary_radius_mm = std::max(1.0, std::min(15.0, estimated_spacing_mm * 6.0));
+	g_boundary_radius_mm = boundary_radius_mm;
