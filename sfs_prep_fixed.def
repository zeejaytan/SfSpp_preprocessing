Bootstrap: docker
From: ubuntu:22.04

%help
  SfS Preprocessing Tools Container (Fixed)
  – includes tiny_obj_loader.h header
  – includes CGAL with proper I/O headers
  – provides MeshPreprocessing and EdgeLineExtraction executables

%labels
  Author    SfS Preprocessing Team
  Version   1.1.0
  Stage     preprocessing-tools-fixed

%environment
  export DEBIAN_FRONTEND=noninteractive
  export TZ=UTC
  export NPROC=$(grep -c ^processor /proc/cpuinfo 2>/dev/null || echo 4)
  export MAKEFLAGS="-j${NPROC} -l${NPROC}"
  export CMAKE_BUILD_PARALLEL_LEVEL=${NPROC}
  export PATH="/opt/sfs_prep/bin:${PATH}"

%post
  # Stage 1: System packages and dependencies
  echo "[STAGE 1] Installing system packages..."
  export DEBIAN_FRONTEND=noninteractive
  export TZ=UTC
  
  apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential cmake git wget unzip curl \
    pkg-config software-properties-common \
    libeigen3-dev libboost-all-dev \
    libopenblas-dev liblapack-dev gfortran \
    libgoogle-glog-dev libgflags-dev \
    libglew-dev freeglut3-dev \
    libusb-1.0-0-dev \
    python3-dev python3-pip \
    && rm -rf /var/lib/apt/lists/*

  # Stage 2: Scientific libraries including CGAL with I/O support (no VTK - build from source)
  echo "[STAGE 2] Installing scientific libraries..."
  apt-get update -qq && apt-get install -y --no-install-recommends \
    libcgal-dev \
    libcgal-qt5-dev \
    libflann-dev \
    libqhull-dev \
    libsuitesparse-dev \
    && rm -rf /var/lib/apt/lists/*
    
  # Stage 2b: Build VTK 8.2 from source (compatible with PCL 1.9.1)
  echo "[STAGE 2b] Building VTK 8.2 from source..."
  cd /tmp
  wget -q https://www.vtk.org/files/release/8.2/VTK-8.2.0.tar.gz
  tar -xf VTK-8.2.0.tar.gz
  mkdir -p VTK-8.2.0/build
  cd VTK-8.2.0/build
  cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr/local \
    -DVTK_MODULE_ENABLE_VTK_RenderingContextOpenGL2=YES \
    -DVTK_USE_SYSTEM_GLEW=ON
  make -j${NPROC}
  make install
  ldconfig
  cd /tmp
  rm -rf VTK-8.2.0*
  
  # Stage 2c: Build PCL 1.9.1 from source (includes NURBS module)
  echo "[STAGE 2c] Building PCL 1.9.1 from source..."
  export PCL_VERSION="1.9.1"
  cd /tmp
  wget -q https://github.com/PointCloudLibrary/pcl/archive/refs/tags/pcl-${PCL_VERSION}.tar.gz
  tar -xf pcl-${PCL_VERSION}.tar.gz
  mkdir -p pcl-pcl-${PCL_VERSION}/build
  cd pcl-pcl-${PCL_VERSION}/build
  cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DVTK_RENDERING_BACKEND=OpenGL2 \
    -DCMAKE_INSTALL_PREFIX=/usr/local \
    -DVTK_DIR=/usr/local/lib/cmake/vtk-8.2
  make -j${NPROC}
  make install
  ldconfig
  cd /tmp
  rm -rf pcl-pcl-*

  # Stage 3: Install missing headers
  echo "[STAGE 3] Installing missing headers..."
  
  # Install tiny_obj_loader.h
  cd /tmp
  wget -q https://raw.githubusercontent.com/tinyobjloader/tinyobjloader/release/tiny_obj_loader.h
  mv tiny_obj_loader.h /usr/local/include/
  
  # Verify CGAL I/O headers (Ubuntu 22.04 uses OBJ subdirectory)
  if [ -f "/usr/include/CGAL/IO/OBJ/File_writer_wavefront.h" ]; then
    echo "✓ CGAL wavefront writer found in OBJ subdirectory"
  else
    echo "Warning: CGAL I/O headers not found, searching..."
    find /usr -name "*wavefront*" -type f 2>/dev/null | head -5
  fi

  # Stage 4: Build preprocessing tools
  echo "[STAGE 4] Building preprocessing tools..."
  mkdir -p /opt/sfs_prep/bin /opt/sfs_prep/lib /opt/sfs_prep/include /opt/sfs_prep/share
  
  # Copy source files (will be bind mounted during build)
  mkdir -p /opt/sfs_prep/src
  
%files
  mesh_processing.cpp /opt/sfs_prep/src/
  edgeline_extraction.cpp /opt/sfs_prep/src/
  CMakeLists.txt /opt/sfs_prep/src/
  alglib/ /opt/sfs_prep/src/alglib/
  data_path.h /opt/sfs_prep/src/

%post
  # Continue building after files are copied
  cd /opt/sfs_prep/src
  
  # Create build directory
  mkdir -p build
  cd build
  
  # Configure with CMake
  echo "Configuring build with CMake..."
  cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/sfs_prep \
    -DCMAKE_CXX_STANDARD=17 \
    -DCMAKE_CXX_FLAGS="-O2 -DNDEBUG -Wno-old-style-cast" \
    || (echo "CMake configuration failed" && exit 1)
  
  # Build with timeout and error handling
  echo "Building preprocessing tools..."
  timeout 1800 make -j${NPROC} || {
    echo "Parallel build failed or timed out, trying single-threaded..."
    make -j1 || (echo "Build failed completely" && exit 1)
  }
  
  # Install executables
  echo "Installing executables..."
  make install || (echo "Installation failed" && exit 1)
  
  # Verify build products
  echo "Build verification:"
  ls -la /opt/sfs_prep/bin/
  
  # Test executables
  if [ -f "/opt/sfs_prep/bin/MeshPreprocessing" ]; then
    echo "✓ MeshPreprocessing built successfully"
  else
    echo "✗ MeshPreprocessing not found"
    exit 1
  fi
  
  if [ -f "/opt/sfs_prep/bin/EdgeLineExtraction" ]; then
    echo "✓ EdgeLineExtraction built successfully"
  else
    echo "✗ EdgeLineExtraction not found"
    exit 1
  fi
  
  # Clean up build files
  cd /opt/sfs_prep
  rm -rf src/build

%test
  # Verify all dependencies and tools
  echo "Testing preprocessing tools..."
  echo "Available headers:"
  ls -la /usr/local/include/tiny_obj_loader.h || echo "tiny_obj_loader.h not found"
  find /usr -name "*wavefront*" -type f 2>/dev/null | head -3
  
  echo "Available executables:"
  ls -la /opt/sfs_prep/bin/ || echo "No executables found"
  
  echo "Preprocessing container ready ✓"

%runscript
  echo "SfS Preprocessing Tools Container"
  echo "Available tools:"
  ls -la /opt/sfs_prep/bin/
  exec "$@"