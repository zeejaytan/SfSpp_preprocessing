+ tar -xzf pcl-1.9.1.tar.gz
+ cd pcl-pcl-1.9.1
+ find . -type f -name '*.h' -o -name '*.hpp' -o -name '*.cpp'
+ xargs sed -i 's|boost/detail/endian.hpp|boost/endian.hpp|g'
+ find . -type f -name '*.h' -o -name '*.hpp' -o -name '*.cpp'
+ xargs sed -i 's|BOOST_LITTLE_ENDIAN|BOOST_ENDIAN_LITTLE_ENDIAN|g'
+ find . -type f -name '*.h' -o -name '*.hpp' -o -name '*.cpp'
+ xargs sed -i 's|BOOST_BIG_ENDIAN|BOOST_ENDIAN_BIG_ENDIAN|g'
+ find . -type f -name '*.h' -o -name '*.hpp' -o -name '*.cpp'
+ xargs sed -i 's|little_endian_byte_order|boost::endian::order::little|g'
+ find . -type f -name '*.h' -o -name '*.hpp' -o -name '*.cpp'
+ xargs sed -i 's|big_endian_byte_order|boost::endian::order::big|g'
+ find . -type f -name '*.h' -o -name '*.hpp' -o -name '*.cpp'
+ xargs sed -i 's|host_byte_order|boost::endian::order::native|g'
+ find . -type f -name PCLPointCloud2.h
+ xargs sed -i 's|#elif defined.*BOOST_ENDIAN_BIG_ENDIAN.*|#elif BOOST_ENDIAN_BIG_ENDIAN|g'
+ find . -type f -name PCLPointCloud2.h
+ xargs sed -i 's|#ifdef.*BOOST_ENDIAN_LITTLE_ENDIAN.*|#if BOOST_ENDIAN_LITTLE_ENDIAN|g'
+ mkdir build
+ cd build
+ cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_surface_on_nurbs=ON -DUSE_UMFPACK=ON -DBUILD_examples=OFF -DBUILD_apps=OFF -DWITH_VTK=OFF -DWITH_QT=OFF -DBUILD_visualization=OFF -DWITH_OPENGL=OFF -DPython3_EXECUTABLE=/usr/bin/python3 ..
